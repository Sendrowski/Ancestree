rule report_msl_agreement_matrix:
    """5-method pairwise MAP-agreement matrix + heatmap (Ancestree
    VCF / ARG / local-tree vs. PolarBEAR vs. EST-SFS) on the chr1 call sets.
    The script reads the per-method call/posterior files by their canonical
    paths. The inputs below sequence those producers in the DAG."""
    input:
        vcf_stream = rules.fit_infer_msl_vcf_streaming.output.anc,
        localtree = rules.infer_msl_local_tree.output.anc,
        arg_chunks = expand(
            f"{DATA}/msl_arg_{{region}}_calls.txt",
            region=MSL_CHR1_CHUNK_REGIONS,
        ),
        polarbear_anc = MSL_REAL_DATA_FILES["polarbear_anc_state"],
        estsfs_anc = MSL_REAL_DATA_FILES["estsfs_anc_state"],
        # The script reads PolarBEAR's per-site posteriors and the population
        # VCF by their canonical archive paths. Declared so the dependency
        # sits in the DAG rather than only in the script.
        polarbear_probs = (f"{MSL_REAL_DATA_ROOT}/ancestral_state/"
                           "PolarBEAR_gammaSMC/prob_ancstate.txt"),
        polarbear_vcf = MSL_REAL_DATA_FILES["msl_vcf_population"],
        # The per-state posterior columns the soft agreement reads. The archive
        # file above carries the flags but only six columns. Named by path, not
        # through ``rules``, since its producer is defined further down.
        prob_full = f"{DATA}/rerun_polarbear_workdir/prob_ancstate_full.txt",
    output:
        json = f"{REPORTS}/msl_agreement_matrix.json",
        pdf = f"{REPORTS}/msl_agreement_heatmap.pdf",
    resources:
        # Not covered by the input-size default: the rerun's wide posterior
        # file (four per-state columns over 1.14M sites) is chosen at runtime
        # by the script and so is not a declared input. Five methods' per-site
        # calls and posteriors are held at once.
        mem_mb = lambda wildcards, attempt: 64000 * attempt,
        runtime = lambda wildcards, attempt: 120 * attempt,
    conda:
        "envs/bench.yml"
    script:
        "scripts/report_msl_agreement_matrix.py"


