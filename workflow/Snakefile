rule report_pi_comparison:
    """Side-by-side π_i: Kingman closed form vs Ancestree Adaptive
    vs fastDFE Adaptive on the larger pi-comparison dataset.
    """
    input:
        ancestree = f"{DATA}/estsfs_pi_ancestree_jc_JC_adaptive_n3.json",
        fastdfe = f"{DATA}/estsfs_pi_fastdfe_jc_JC_adaptive_n3.json",
        meta = rules.simulate_estsfs_pi.output.meta,
    output:
        json = f"{REPORTS}/estsfs_pi_comparison.json",
        md = f"{REPORTS}/estsfs_pi_comparison.md",
    params:
        sim_config = ESTSFS_PI_CONFIG,
    conda:
        "envs/bench.yml"
    script:
        "scripts/report_pi_comparison.py"


rule report_estsfs:
    """Aggregate all (sim, model, prior, n_out) cells → report.

    The manuscript-grade baseline is the original C est-sfs (Keightley &
    Jackson 2018). fastDFE's est-sfs is kept as a separate development
    sanity check and consumed alongside.
    """
    input:
        ancestree = expand(
            f"{DATA}/estsfs_ancestree_{{sim}}_{{model}}_{{prior}}_n{{n_out}}.json",
            sim=list(ESTSFS_SIMS), model=ESTSFS_MODELS,
            prior=ESTSFS_PRIORS, n_out=ESTSFS_N_OUTS,
        ),
        baseline = expand(
            f"{DATA}/estsfs_baseline_{{sim}}_{{model}}_n{{n_out}}.json",
            sim=list(ESTSFS_SIMS), model=ESTSFS_MODELS, n_out=ESTSFS_N_OUTS,
        ),
        fastdfe = expand(
            f"{DATA}/estsfs_fastdfe_{{sim}}_{{model}}_{{prior}}_n{{n_out}}.json",
            sim=list(ESTSFS_SIMS), model=ESTSFS_FASTDFE_MODELS,
            prior=ESTSFS_PRIORS, n_out=ESTSFS_N_OUTS,
        ),
        # The JC sim's .trees serve the per-site truth lookup (both sims
        # share demography, so ancestral states are identical for matched
        # positions). The kappa truth is reported from meta per sim.
        trees = f"{DATA}/estsfs_sim_jc.trees",
        meta = f"{DATA}/estsfs_sim_jc_meta.json",
    output:
        json = f"{REPORTS}/estsfs_agreement.json",
        md = f"{REPORTS}/estsfs_agreement.md",
    params:
        sims = list(ESTSFS_SIMS),
        sim_specs = ESTSFS_SIMS,
        models = ESTSFS_MODELS,
        priors = ESTSFS_PRIORS,
        n_outs = ESTSFS_N_OUTS,
        sim_config = ESTSFS_CONFIG,
    conda:
        "envs/bench.yml"
    script:
        "scripts/report_estsfs.py"



