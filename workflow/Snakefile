DEMOG_SCENARIOS = ["pop_constant", "pop_growth", "pop_decline"]
# Ingroup-size grid: per-bin SFS accuracy of ARGBasedInference in
# ingroup-only mode (n_out=0) as a function of how many ingroup
# haplotypes the local tree contains. Same simulated ARG, randomly
# subsampled to ``n_ingroup`` with a per-cell seed. Not in ``rule all``.
# Build via ``snakemake -j 1 report_ingroup_size`` on demand.
INGROUP_SIZE_CONFIG = dict(
