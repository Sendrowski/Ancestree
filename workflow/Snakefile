def _robustness_intersect_chunk_inputs(wc):
    """Inputs for ONE chunk of an intersection cell.

    The same set :func:`_robustness_intersect_inputs` names, restricted to this
    chunk, so the ten chunks fan out instead of one job re-scoring all of them
    serially.
    """
    chunks = [int(wc.chunk_idx)]
    s, method, n = wc.scenario, wc.method, int(wc.n_out)
    if s == "slim":
        sims = expand(f"{DATA}/slim_outgroup_bias10_fdel1.0_chunk{{c}}_meta.json",
                      c=chunks)
    else:
        sims = expand(f"{DATA}/{MSP_STEM[s]}_chunk{{c}}_meta.json", c=chunks)
    # Every method, not only the ARG-based ones. The common covered set is the
    # intersection over tsinfer, Relate and the averaged SINGER chains, so
    # ``intersect_mask_for_chunk`` reads all three whatever is being scored:
    # re-inferring any one of them narrows the mask, and a cell that did not
    # depend on it would stay graded on a wider site set than its comparators.
    deps = list(sims)
    deps += expand(
        f"{DATA}/robustness_arg_tsinfer_{s}_n{n}_chunk{{c}}/meta.json",
        c=chunks)
    deps += [
        f"{DATA}/robustness_arg_relate_{s}_relate_arg_panel_ft_n{n}"
        f"_chunk{c}_w0_s0/meta.json"
        for c in chunks]
    # The mask reads where each method's ARG reaches, so a chunk SINGER cannot
    # infer at any seed contributes nothing and must not be demanded.
    singer_chunks = [c for c in chunks if c in set(
        _singer_seeds_module().scored_chunks(
            s, "singer_arg_panel", n, n_chunks=max(chunks) + 1))]
    deps += [
        f"{DATA}/robustness_arg_singer_{s}_singer_arg_panel_n{n}_chunk{c}"
        f"_w0_s{seed}/meta.json"
        for c in singer_chunks
        for seed in _singer_runnable_seeds(s, "singer_arg_panel", n, c,
                                           SINGER_N_CHAINS)]
    if method in SINGER_METHODS:
        own = set(_singer_seeds_module().scored_chunks(
            s, method, n, n_chunks=max(chunks) + 1))
        deps += [
            f"{DATA}/robustness_arg_singer_{s}_{method}_n{n}_chunk{c}"
            f"_w0_s{seed}/meta.json"
            for c in chunks if c in own
            for seed in _singer_runnable_seeds(s, method, n, c,
                                               SINGER_N_CHAINS)]
    return sorted(set(deps))


def _robustness_intersect_inputs(wc):
    """Inputs for one intersection cell: the chunk simulations, plus only the
    persisted ARGs that this method's re-scoring actually reads.

    Deliberately not the ordinary per-chunk summaries. Those are a different
    figure's outputs, and requiring them would make an intersection cell wait on
    work it never consumes. For ``anc_ft`` that is a per-chunk L-BFGS ladder
    fit costing hours, to produce a cell that rescores from the chunk trees in
    seconds. The genealogy-carrying methods (true-ARG, local-tree, fixed-tree)
    need only the simulations. The panel-ARG methods need their own ARGs."""
    s = wc.scenario
    method = wc.method
    n = int(wc.n_out)
    if s == "slim":
        chunks = ROBUSTNESS_SLIM_CHUNKS
        sims = expand(f"{DATA}/slim_outgroup_bias10_fdel1.0_chunk{{c}}_meta.json",
                      c=chunks)
    else:
        chunks = ROBUSTNESS_MSP_CHUNKS
        stem = MSP_STEM[s]
        sims = expand(f"{DATA}/{stem}_chunk{{c}}_meta.json", c=chunks)
    if method == "tsinfer_arg":
        return sims + expand(
            f"{DATA}/robustness_arg_tsinfer_{s}_n{n}_chunk{{c}}/meta.json",
            c=chunks)
    if method in SINGER_METHODS:
        # The re-scoring merges SINGER_N_CHAINS chains per chunk and refuses to
        # score short, so depend on all of them, on the seeds SINGER does not
        # abort on. Naming only the first seed leaves the rest unbuilt and the
        # cell fails at merge time on a chunk whose low seeds abort.
        return sims + [
            f"{DATA}/robustness_arg_singer_{s}_{method}_n{n}_chunk{c}"
            f"_w0_s{seed}/meta.json"
            for c in chunks
            for seed in _singer_runnable_seeds(s, method, n, c,
                                               SINGER_N_CHAINS)]
    if method == "relate_arg_panel_ft":
        # Relate is deterministic: one run per chunk, and it never aborts.
        return sims + [
            f"{DATA}/robustness_arg_relate_{s}_{method}_n{n}_chunk{c}"
            f"_w0_s0/meta.json"
            for c in chunks]
    return sims


def _robustness_cell_inputs(wc):
    """Scenario-dependent inputs for one heatmap cell (DAG ordering only;
    the script reads data via repo-relative paths). Shared by the general
    score_robustness_cell rule and the tsinfer-specific rule, whose output
    fixes the method, so fall back to ``tsinfer_arg`` when no method
    wildcard is present."""
    s = wc.scenario
    method = getattr(wc, "method", "tsinfer_arg")
    if s in CHUNKED_MSP_SCENARIOS:
        # Chunked msprime: the cell concatenates per-chunk inference JSONs
        # (one parallel job per chunk, every method), so depend on those plus
        # the chunk metas (chunk0 meta gives n_ingroup / n_outgroups).
        stem = MSP_STEM[s]
        n = int(wc.n_out)
        metas = expand(f"{DATA}/{stem}_chunk{{c}}_meta.json",
                       c=ROBUSTNESS_MSP_CHUNKS)
        return metas + expand(
            f"{DATA}/robustness_chunk_{s}_{method}_n{n}_chunk{{c}}_summary.json",
            c=ROBUSTNESS_MSP_CHUNKS,
        )
    if s == "slim":
        # 10-outgroup SLiM sim (separate from the 3-outgroup one).
        metas = expand(
            f"{DATA}/slim_outgroup_bias10_fdel1.0_chunk{{c}}_meta.json",
            c=ROBUSTNESS_SLIM_CHUNKS,
        )
        n = int(wc.n_out)
        # ARG mode and the parsimony / majority baselines are computed live from
        # the chunk trees (which co-build with the metas), so they need no
        # per-chunk dependency. Local-tree mode is not built on this all-sites
        # path at all. Every figure row for it comes from the intersection
        # cells (rule robustness_intersect_cell).
        if method in SINGER_METHODS:
            # SINGER cell = concat of the per-chunk SINGER summaries (built by
            # score_robustness_singer_chunk from the budget-window shards).
            return metas + expand(
                f"{DATA}/robustness_chunk_slim_{method}_n{n}_chunk{{c}}_summary.json",
                c=ROBUSTNESS_SLIM_CHUNKS,
            )
        if method in RELATE_METHODS:
            # Relate cell = concat of the per-chunk Relate summaries (built by
            # score_robustness_relate_chunk from the budget-window shards).
            return metas + expand(
                f"{DATA}/robustness_chunk_slim_{method}_n{n}_chunk{{c}}_summary.json",
                c=ROBUSTNESS_SLIM_CHUNKS,
            )
        if method == "tsinfer_arg":
            # tsinfer cell = concat of the per-chunk tsinfer summaries (built by
            # score_robustness_tsinfer_chunk from the persisted per-chunk ARGs).
            return metas + expand(
                f"{DATA}/robustness_chunk_slim_tsinfer_arg_n{n}_chunk{{c}}_summary.json",
                c=ROBUSTNESS_SLIM_CHUNKS,
            )
        return metas
    return []


def _robustness_cell_mem(wildcards, attempt):
    """Per-cell memory (MB). Chunked-msprime cells are pure concats of the
    per-chunk JSONs (cheap). The SLiM anc_ft / anc_ft_adaptive cell still runs
    a live pooled fixed-tree fit, so it gets headroom. Everything else fits the
    default."""
    method = getattr(wildcards, "method", "")
    if wildcards.scenario == "slim" and method.startswith("anc_ft"):
        return 16000 * attempt
    return 8000 * attempt


def _robustness_cell_runtime(wildcards, attempt):
    """Per-cell wall time (minutes). Concats are quick. The SLiM pooled
    fixed-tree fit gets a wider budget."""
    method = getattr(wildcards, "method", "")
    if wildcards.scenario == "slim" and method.startswith("anc_ft"):
        return 480 * attempt
    return 240 * attempt


# ---- per-chunk inference (chunked msprime scenarios) -----------------------
def _robustness_chunk_inputs(wc):
    """Inputs for one per-chunk inference job: the chunk's sim trees + meta.
    Falls back to ``tsinfer_arg`` for the tsinfer rule (no method wildcard).
    Handles SLiM (loaded via SlimScenario) as well as the msprime scenarios."""
    if wc.scenario == "slim":
        base = f"{DATA}/slim_outgroup_bias10_fdel1.0_chunk{wc.chunk_idx}"
        return [f"{base}.trees", f"{base}_meta.json"]
    stem = MSP_STEM[wc.scenario]
    return [f"{DATA}/{stem}_chunk{wc.chunk_idx}.trees",
            f"{DATA}/{stem}_chunk{wc.chunk_idx}_meta.json"]


def _robustness_chunk_mem(wildcards, attempt):
    """Per-chunk memory (MB). Each chunk is ~1/10 the sites (dense ~0.6–0.7M,
    sparse ~30K). anc_ft forks its restarts (parallelize=True), and
    majority/Fitch materialise per-site Python."""
    method = getattr(wildcards, "method", "")
    dense = wildcards.scenario in ROBUSTNESS_DENSE_SCENARIOS
    if method.startswith("anc_ft"):
        return (24000 if dense else 12000) * attempt
    if method == "majority_outgroup":
        return (16000 if dense else 8000) * attempt
    return 8000 * attempt


def _robustness_chunk_runtime(wildcards, attempt):
    """Per-chunk wall time (minutes). The anc_ft L-BFGS fit cost is set by the
    outgroup-pattern config table (n_out), not the site count, so n_out=10 is
    still ~hours per chunk even at 1/10 the sites."""
    method = getattr(wildcards, "method", "")
    if method.startswith("anc_ft"):
        return 480 * attempt
    return 240 * attempt


def _robustness_chunk_threads(wildcards):
    method = getattr(wildcards, "method", "")
    if method.startswith("anc_ft"):
        return 10
    if "local_tree" in method:
        return LOCAL_TREE_THREADS
    return 1


rule score_robustness_chunk:
    """One (scenario, method, n_out) result for a single msprime chunk → JSON
    (the cell job concatenates these). Excludes tsinfer_arg (separate env)."""
    input:
        _robustness_chunk_inputs,
    output:
        f"{DATA}/robustness_chunk_{{scenario}}_{{method}}_n{{n_out}}_chunk{{chunk_idx}}_summary.json",
    wildcard_constraints:
        scenario = r"|".join(CHUNKED_MSP_SCENARIOS),
        method = r"|".join(m for m in ROBUSTNESS_ALL_METHODS if m != "tsinfer_arg"),
        n_out = r"[0-9]+",
        chunk_idx = r"[0-9]+",
    threads: _robustness_chunk_threads
    resources:
        mem_mb = _robustness_chunk_mem,
        runtime = _robustness_chunk_runtime,
    conda:
        "envs/bench.yml"
    script:
        "scripts/score_robustness_chunk.py"


rule infer_robustness_tsinfer_arg_chunk:
    """Infer + persist one tsinfer ARG for a single msprime chunk (inference
    only): (scenario, n_out, chunk) -> a directory with the dated tsinfer ARG
    (draw_0.tsz) + meta.json. Builds the ARG in the dedicated tsinfer env
    (tsinfer.yml). Split from scoring (score_robustness_tsinfer_chunk) so the
    ARG persists for re-scoring."""
    input:
        _robustness_chunk_inputs,
    output:
        f"{DATA}/robustness_arg_tsinfer_{{scenario}}_n{{n_out}}"
        f"_chunk{{chunk_idx}}/meta.json",
    wildcard_constraints:
        scenario = r"|".join(CHUNKED_MSP_SCENARIOS + ["slim"]),
        n_out = r"[0-9]+",
        chunk_idx = r"[0-9]+",
    resources:
        # tsinfer builds an ARG from a single chunk (~1/10 the sites), so ~32 GB
        # on the dense scenarios is ample, all well inside the short cap.
        mem_mb = lambda wildcards, attempt: (32000 if wildcards.scenario in ROBUSTNESS_DENSE_SCENARIOS else 12000) * attempt,
        runtime = lambda wildcards, attempt: capped_runtime(480 if wildcards.scenario in ROBUSTNESS_DENSE_SCENARIOS else 240, attempt),
    conda:
        "envs/tsinfer.yml"
    script:
        "scripts/infer_tsinfer_arg_chunk.py"


rule score_robustness_tsinfer_chunk:
    """Score one persisted tsinfer ARG chunk -> per-chunk summary. Lays the
    panel's full site set onto tsinfer's dated local trees (the Felsenstein
    kernel). Scoring only (no tsinfer import), so it runs in the ancestree
    stack (bench.yml) and is arm64-portable. The output fixes the method to
    tsinfer_arg."""
    input:
        f"{DATA}/robustness_arg_tsinfer_{{scenario}}_n{{n_out}}"
        f"_chunk{{chunk_idx}}/meta.json",
        _robustness_chunk_inputs,
    output:
        f"{DATA}/robustness_chunk_{{scenario}}_tsinfer_arg_n{{n_out}}_chunk{{chunk_idx}}_summary.json",
    wildcard_constraints:
        scenario = r"|".join(CHUNKED_MSP_SCENARIOS + ["slim"]),
        n_out = r"[0-9]+",
        chunk_idx = r"[0-9]+",
    resources:
        mem_mb = lambda wildcards, attempt: (12000 if wildcards.scenario in ROBUSTNESS_DENSE_SCENARIOS else 6000) * attempt,
        runtime = lambda wildcards, attempt: (120 if wildcards.scenario in ROBUSTNESS_DENSE_SCENARIOS else 60) * attempt,
    conda:
        "envs/bench.yml"
    script:
        "scripts/score_tsinfer_chunk.py"


rule score_robustness_cell:
    """One (scenario, method, n_out) heatmap cell → summary JSON. For chunked
    msprime scenarios this is a cheap concat of the per-chunk JSONs. For SLiM
    it aggregates the SLiM chunks (with a live pooled fixed-tree fit)."""
    input:
        _robustness_cell_inputs,
    output:
        f"{DATA}/robustness_cell_{{scenario}}_{{method}}_n{{n_out}}_summary.json",
    wildcard_constraints:
        scenario = r"|".join(ROBUSTNESS_SCENARIOS + DEMOG_SCENARIOS),
        method = r"|".join(ROBUSTNESS_ALL_METHODS),
        n_out = r"[0-9]+",
    resources:
        mem_mb = _robustness_cell_mem,
        runtime = _robustness_cell_runtime,
    conda:
        "envs/bench.yml"
    script:
        "scripts/score_robustness_cell.py"


# Method rows per heatmap figure. Mirrors _robustness_common.HEATMAP_FIGURES,
# which carries the same rows with their plot labels. The renderer's coverage
# guard fails loudly if the two ever drift. Keys are the {figure} wildcard of
# rule report_robustness_heatmap.
ROBUSTNESS_FIGURE_METHODS = {
    # The main comparison: the three inference modes against the three external
    # ARG pipelines.
    "robustness_heatmap": [
        "anc_arg", "local_tree_unphased", "anc_ft", "singer_arg_panel",
        "tsinfer_arg", "relate_arg_panel_ft",
    ],
    # Appendix replica: adds the parsimony limits, the adaptive fixed-tree
    # prior, the majority-outgroup baseline and SINGER's fixed-tree variant.
    "robustness_baselines": [
        "anc_arg", "parsimony_mu0", "local_tree_unphased",
        "singer_arg_panel", "singer_arg_panel_ft", "tsinfer_arg",
        "relate_arg_panel_ft", "anc_ft", "anc_ft_adaptive", "majority_outgroup",
    ],
}
# Every figure is graded on the common covered site set, so an intersection cell
# exists for every method any figure plots.
INTERSECT_METHODS = sorted(
    {m for methods in ROBUSTNESS_FIGURE_METHODS.values() for m in methods})


#: Ensemble sizes the sample curve covers, and the chunks each point averages
#: over. Powers of two so the x axis reads as doublings. Three chunks keeps the
#: grid affordable across five scenarios (5 x 3 x 8 = 120 inference jobs).
SAMPLECURVE_KS = [1, 2, 4, 8, 16, 32, 64, 128, 256, 512]
SAMPLECURVE_CHUNKS = [0, 1, 2]
#: SLiM has 100 chunks against the msprime scenarios' 10 and its per-chunk
#: spread is correspondingly wider, so three of them is a much noisier estimate
#: than three of the others. It gets more, so the bands are comparable.
SAMPLECURVE_CHUNKS_SLIM = list(range(10))
SAMPLECURVE_N_OUT = 3


def samplecurve_chunks(scenario: str) -> list:
    """Chunks the sample curve averages over, per scenario."""
    return (SAMPLECURVE_CHUNKS_SLIM if scenario == "slim"
            else SAMPLECURVE_CHUNKS)


def _samplecurve_inputs(wc):
    """The chunk simulation one sample-curve point is computed from.

    The script reaches its data through ``rc._chunk_scenario``, so without this
    the point sits in the DAG with no edge to the simulation it scores.
    """
    if wc.scenario == "slim":
        base = f"{DATA}/slim_outgroup_bias10_fdel1.0_chunk{wc.chunk}"
        return [f"{base}.trees", f"{base}_meta.json"]
    stem = MSP_STEM[wc.scenario]
    return [f"{DATA}/{stem}_chunk{wc.chunk}.trees",
            f"{DATA}/{stem}_chunk{wc.chunk}_meta.json"]


rule local_tree_samplecurve_point:
    """One (scenario, chunk, ensemble size) point of the sample curve.

    Sharded one job per point so the pairwise-HMM forward pass each needs runs
    concurrently rather than serially in one process."""
    input:
        _samplecurve_inputs,
    output:
        f"{DATA}/samplecurve_local_tree_{{scenario}}_n{{n_out}}_chunk{{chunk}}_k{{k}}.json",
    wildcard_constraints:
        scenario=r"[a-z_0-9]+", n_out=r"[0-9]+", chunk=r"[0-9]+", k=r"[0-9]+",
    threads: LOCAL_TREE_THREADS
    # The grid launches ~100 jobs at once and they all JIT the same kernels
    # into one on-disk numba cache, so a few lose the race in save_overload.
    # The cache is populated by then, so a retry compiles nothing and succeeds.
    retries: 2
    resources:
        # The pairwise HMM holds an n_pairs x n_blocks matrix. The ensemble
        # size only multiplies the cheap scoring pass, so memory is flat in k.
        mem_mb = lambda wildcards, attempt: 16000 * attempt,
        runtime = lambda wildcards, attempt: 120 * attempt,
    conda:
        "envs/bench.yml"
    script:
        "scripts/local_tree_samplecurve_point.py"


rule local_tree_samplecurve_figure:
    """Fig: ground-truth recovery (Brier) against ensemble size, per scenario."""
    input:
        cells = [f"{DATA}/samplecurve_local_tree_{s}_n{SAMPLECURVE_N_OUT}"
                 f"_chunk{c}_k{k}.json"
                 for s in ROBUSTNESS_SCENARIOS
                 for c in samplecurve_chunks(s)
                 for k in SAMPLECURVE_KS],
    output:
        pdf = f"{REPORTS}/bench_local_tree_samplecurve.pdf",
        fig_copy = "reports/manuscripts/latex/figures/bench_local_tree_samplecurve.pdf",
    conda:
        "envs/bench.yml"
    script:
        "scripts/plot_local_tree_samplecurve.py"


rule robustness_intersect_chunk:
    """One chunk of an intersection cell, scored on the common covered set.

    The shard the cell sums. Chunks are independent, so they fan out.
    """
    input:
        _robustness_intersect_chunk_inputs,
    output:
        f"{DATA}/robustness_chunk_intersect_{{scenario}}_{{method}}"
        f"_n{{n_out}}_chunk{{chunk_idx}}_summary.json",
    wildcard_constraints:
        scenario = r"|".join(ROBUSTNESS_SCENARIOS),
        method = r"|".join(INTERSECT_METHODS),
        n_out = r"[0-9]+",
        chunk_idx = r"[0-9]+",
    params:
        # As a rule param, not an environment read inside the job: a SLURM job
        # does not necessarily inherit SINGER_BURN_IN.
        burn_in = SINGER_BURN_IN,
        # Same reason: an unpassed env var lets two runs score at different
        # ensemble sizes with nothing in the output to tell them apart.
        ensemble_members = LOCAL_TREE_ENSEMBLE_MEMBERS,
    # local_tree_unphased is not a persisted-ARG method, so this rule runs its
    # full pairwise HMM and ensemble rather than re-reading draws.
    threads: LOCAL_TREE_THREADS
    resources:
        mem_mb = lambda wildcards, attempt: (24000 if wildcards.scenario == "slim" else 8000) * attempt,
        runtime = lambda wildcards, attempt: capped_runtime(
            (240 if wildcards.scenario == "slim" else 120), attempt),
    conda:
        "envs/bench.yml"
    script:
        "scripts/compute_intersect_chunk.py"


rule robustness_intersect_cell:
    """One ARG-comparison cell scored on the cross-method common covered site set
    (SINGER's budget prefix per chunk), so every method in the ARG-inference
    heatmap is graded on one identical site set. Re-scores the persisted per-chunk
    ARGs / shard posteriors under the coverage mask, with no re-inference and no
    tsinfer import (the dated ARG is scored with the kernel), so it runs in
    bench.yml. Depends only on what the re-scoring reads (see
    _robustness_intersect_inputs)."""
    input:
        lambda wc: expand(
            f"{DATA}/robustness_chunk_intersect_{wc.scenario}_{wc.method}"
            f"_n{wc.n_out}_chunk{{c}}_summary.json",
            c=_singer_seeds_module().scored_chunks(
                wc.scenario, wc.method, int(wc.n_out),
                n_chunks=(SLIM10_N_CHUNKS if wc.scenario == "slim"
                          else ROBUSTNESS_MSP_N_CHUNKS))),
    output:
        f"{DATA}/robustness_cell_intersect_{{scenario}}_{{method}}_n{{n_out}}_summary.json",
    wildcard_constraints:
        scenario = r"|".join(ROBUSTNESS_SCENARIOS),
        method = r"|".join(INTERSECT_METHODS),
        n_out = r"[0-9]+",
    resources:
        # Sums the shards, so seconds rather than hours.
        mem_mb = lambda wildcards, attempt: 4000 * attempt,
        runtime = lambda wildcards, attempt: 30 * attempt,
    conda:
        "envs/bench.yml"
    script:
        "scripts/compute_intersect_cell.py"


rule robustness_intersect_cells:
    """Aggregate: build every intersection-scored cell the heatmap figures read.
    Run on the cluster after the ordinary ARG cells/ARGs exist::

        snakemake --scheduler greedy robustness_intersect_cells
    """
    input:
        expand(
            f"{DATA}/robustness_cell_intersect_{{scenario}}_{{method}}_n{{n_out}}_summary.json",
            scenario=ROBUSTNESS_SCENARIOS,
            method=INTERSECT_METHODS,
            n_out=ROBUSTNESS_N_OUTS,
        ),


rule score_robustness_tsinfer_cell:
    """tsinfer-ARG (fixed-tree-MAP AA) heatmap cell. tsinfer lives in its own
    dedicated ``envs/tsinfer.yml`` conda env (kept out of base / bench), so
    this rule sets that env via the conda directive, separate from
    score_robustness_cell (whose method wildcard deliberately excludes
    ``tsinfer_arg``)."""
    input:
        _robustness_cell_inputs,
    output:
        f"{DATA}/robustness_cell_{{scenario}}_tsinfer_arg_n{{n_out}}_summary.json",
    wildcard_constraints:
        scenario = r"|".join(ROBUSTNESS_SCENARIOS),
        n_out = r"[0-9]+",
    resources:
        # Chunked msprime: a cheap concat of the per-chunk tsinfer JSONs (the
        # heavy tsinfer build lives in score_robustness_tsinfer_chunk). SLiM:
        # still aggregates 100 live per-chunk tsinfer builds, so a bit wider.
        mem_mb = lambda wildcards, attempt: (24000 if wildcards.scenario == "slim" else 8000) * attempt,
        runtime = lambda wildcards, attempt: capped_runtime(480 if wildcards.scenario == "slim" else 240, attempt),
    conda:
        "envs/tsinfer.yml"
    script:
        "scripts/score_robustness_tsinfer_cell.py"


rule materialize_robustness_ftmap:
    """Whole-chunk fixed-tree MAP orientation per (scenario, chunk, n_out),
    cached as JSON {pos: map_allele}. The ``_ft`` ARG shards read this sidecar
    via ``Scenario._fixed_tree_map_by_pos`` (computing and caching it inline on
    a miss). Not a rule input of the shards: a hard dependency on this shared
    artifact would cascade a regeneration into re-inferring every ``_ft`` ARG,
    so run these targets explicitly to pre-warm the cache."""
    input:
        _robustness_chunk_inputs,
    output:
        f"{DATA}/ftmap_{{scenario}}_chunk{{chunk_idx}}_n{{n_out}}.json",
    wildcard_constraints:
        scenario = r"|".join(CHUNKED_MSP_SCENARIOS + ["slim"]),
        n_out = r"[0-9]+",
        chunk_idx = r"[0-9]+",
    resources:
        mem_mb = lambda wildcards, attempt: (16000 if wildcards.scenario in ROBUSTNESS_DENSE_SCENARIOS else 8000) * attempt,
        runtime = lambda wildcards, attempt: (360 if wildcards.scenario in ROBUSTNESS_DENSE_SCENARIOS else 120) * attempt,
    conda:
        "envs/bench.yml"
    script:
        "scripts/materialize_ftmap.py"


rule infer_robustness_singer_arg_shard:
    """Infer + persist one SINGER ARG shard (inference only): (scenario, method,
    n_out, chunk, window, seed) -> a directory of thinned draw_{k}.trees +
    meta.json. Runs SINGER (one MCMC chain) on the chunk's budget-subsample
    window (ingroup + n_out outgroups). The SINGER binary (SINGER_DIR, built by
    workflow/scripts/install_singer.sh) is a standalone ELF called via
    subprocess in the ancestree stack (bench.yml). SINGER is arm64-blocked, so
    this step runs on Linux. Persisting the draws lets scoring
    (score_robustness_singer_shard) re-run anywhere without the MCMC.
    Depends on the chunk's sim trees so regenerating a scenario invalidates the
    persisted ARG (mtime trigger) instead of silently reusing a stale draw."""
    input:
        _robustness_chunk_inputs,
        singer = f"{SINGER_DIR}/singer",
    output:
        # protected(): a SINGER shard is hours of MCMC and the draws are the
        # expensive artifact of the whole benchmark. Write-protecting them
        # makes an accidental re-inference fail loudly instead of silently
        # spending the budget. Removing a draw deliberately needs chmod +w.
        protected(
            f"{DATA}/robustness_arg_singer_{{scenario}}_{{method}}_n{{n_out}}"
            f"_chunk{{chunk_idx}}_w{{window_idx}}_s{{seed}}/meta.json"),
    wildcard_constraints:
        scenario = r"|".join(SINGER_SCENARIOS),
        method = r"|".join(SINGER_METHODS),
        n_out = r"[0-9]+",
        chunk_idx = r"[0-9]+",
        window_idx = r"[0-9]+",
        seed = r"[0-9]+",
    params:
        singer_dir = SINGER_DIR,
        n_iters = SINGER_N_ITERS,
        thin = SINGER_THIN,
    resources:
        # One budget window (~SINGER_PANEL_SITE_BUDGET SNPs) of one MCMC chain.
        # Dense scenarios pack more local trees per window, so a bit more room.
        mem_mb = lambda wildcards, attempt: (16000 if wildcards.scenario in ROBUSTNESS_DENSE_SCENARIOS else 8000) * attempt,
        runtime = lambda wildcards, attempt: 300 * attempt,
    conda:
        "envs/bench.yml"
    script:
        "scripts/infer_singer_arg_shard.py"


rule score_robustness_singer_shard:
    """Score one persisted SINGER ARG shard -> per-site posterior JSON. Lays the
    panel's full in-window site set onto each thinned draw's local trees and
    averages (dropping SINGER_BURN_IN warm-up draws). Scoring only (no SINGER
    binary), so it runs on arm64 regardless of where the ARG was inferred."""
    input:
        f"{DATA}/robustness_arg_singer_{{scenario}}_{{method}}_n{{n_out}}"
        f"_chunk{{chunk_idx}}_w{{window_idx}}_s{{seed}}/meta.json",
    output:
        f"{DATA}/robustness_singer_shard_{{scenario}}_{{method}}_n{{n_out}}"
        f"_chunk{{chunk_idx}}_w{{window_idx}}_s{{seed}}.json",
    wildcard_constraints:
        scenario = r"|".join(SINGER_SCENARIOS),
        method = r"|".join(SINGER_METHODS),
        n_out = r"[0-9]+",
        chunk_idx = r"[0-9]+",
        window_idx = r"[0-9]+",
        seed = r"[0-9]+",
    params:
        burn_in = SINGER_BURN_IN,
    resources:
        mem_mb = lambda wildcards, attempt: (12000 if wildcards.scenario in ROBUSTNESS_DENSE_SCENARIOS else 6000) * attempt,
        runtime = lambda wildcards, attempt: 60 * attempt,
    conda:
        "envs/bench.yml"
    script:
        "scripts/score_arg_shard.py"


rule score_robustness_singer_chunk:
    """Merge the SINGER shards for one chunk (average MCMC chains, score) into a
    per-chunk summary in the SAME format as every other per-chunk summary, so
    the existing cell concat picks it up. Scoring only (no SINGER binary), so it
    runs in the bench env."""
    input:
        _singer_shard_inputs,
    output:
        f"{DATA}/robustness_chunk_{{scenario}}_{{method}}_n{{n_out}}_chunk{{chunk_idx}}_summary.json",
    params:
        # Passed explicitly for the same reason robustness_intersect_chunk
        # passes it: a SLURM job does not necessarily inherit SINGER_BURN_IN,
        # and these summaries are compared against the shard and intersection
        # paths, which both average over the same draws.
        burn_in = SINGER_BURN_IN,
    wildcard_constraints:
        scenario = r"|".join(SINGER_SCENARIOS),
        method = r"|".join(SINGER_METHODS),
        n_out = r"[0-9]+",
        chunk_idx = r"[0-9]+",
    resources:
        mem_mb = lambda wildcards, attempt: 8000 * attempt,
        runtime = lambda wildcards, attempt: 60 * attempt,
    conda:
        "envs/bench.yml"
    script:
        "scripts/score_robustness_singer_chunk.py"


rule score_robustness_singer_cell:
    """SINGER heatmap cell = concat of the per-chunk SINGER summaries (reuses
    score_robustness_cell.py, as SINGER methods are kept out of the general cell
    rule's wildcard, like tsinfer_arg)."""
    input:
        _robustness_cell_inputs,
    output:
        f"{DATA}/robustness_cell_{{scenario}}_{{method}}_n{{n_out}}_summary.json",
    wildcard_constraints:
        scenario = r"|".join(SINGER_SCENARIOS),
        method = r"|".join(SINGER_METHODS),
        n_out = r"[0-9]+",
    resources:
        mem_mb = lambda wildcards, attempt: 8000 * attempt,
        runtime = lambda wildcards, attempt: 240 * attempt,
    conda:
        "envs/bench.yml"
    script:
        "scripts/score_robustness_cell.py"


rule infer_robustness_relate_arg_shard:
    """Infer + persist one Relate ARG shard (inference only): (scenario, method,
    n_out, chunk, window, seed) -> a directory of draw_{k}.trees + meta.json.
    Runs Relate (one deterministic genealogy) on the chunk's budget-subsample
    window (ingroup + n_out outgroups). The Relate binary (RELATE_DIR, installed
    by workflow/scripts/install_relate.sh) is called via subprocess, so the rule
    runs in the ancestree stack (bench.yml) with RELATE_DIR passed as a param.
    Relate is native arm64, so this runs locally. Split from scoring
    (score_robustness_relate_shard) so the ARG persists for re-scoring.
    Depends on the chunk's sim trees so regenerating a scenario invalidates the
    persisted ARG (mtime trigger) instead of silently reusing a stale draw."""
    input:
        _robustness_chunk_inputs,
        relate = f"{RELATE_DIR}/bin/Relate",
    output:
        f"{DATA}/robustness_arg_relate_{{scenario}}_{{method}}_n{{n_out}}"
        f"_chunk{{chunk_idx}}_w{{window_idx}}_s{{seed}}/meta.json",
    wildcard_constraints:
        scenario = r"|".join(RELATE_SCENARIOS),
        method = r"|".join(RELATE_METHODS),
        n_out = r"[0-9]+",
        chunk_idx = r"[0-9]+",
        window_idx = r"[0-9]+",
        seed = r"[0-9]+",
    params:
        relate_dir = RELATE_DIR,
    resources:
        mem_mb = lambda wildcards, attempt: (16000 if wildcards.scenario in ROBUSTNESS_DENSE_SCENARIOS else 8000) * attempt,
        # Dense _ft shards recompute the whole-chunk fixed-tree MAP orientation
        # (FixedTreeInference.fit over ~700k sites), and Relate then adds its
        # own subprocess.
        runtime = lambda wildcards, attempt: (360 if wildcards.scenario in ROBUSTNESS_DENSE_SCENARIOS else 120) * attempt,
    conda:
        "envs/bench.yml"
    script:
        "scripts/infer_relate_arg_shard.py"


rule score_robustness_relate_shard:
    """Score one persisted Relate ARG shard -> per-site posterior JSON. Lays the
    panel's full in-window site set onto Relate's local trees (the Felsenstein
    kernel). Scoring only (no Relate binary), so it is cheap and arm64-portable.
    Fanned out / merged by score_robustness_relate_chunk."""
    input:
        f"{DATA}/robustness_arg_relate_{{scenario}}_{{method}}_n{{n_out}}"
        f"_chunk{{chunk_idx}}_w{{window_idx}}_s{{seed}}/meta.json",
    output:
        f"{DATA}/robustness_relate_shard_{{scenario}}_{{method}}_n{{n_out}}"
        f"_chunk{{chunk_idx}}_w{{window_idx}}_s{{seed}}.json",
    wildcard_constraints:
        scenario = r"|".join(RELATE_SCENARIOS),
        method = r"|".join(RELATE_METHODS),
        n_out = r"[0-9]+",
        chunk_idx = r"[0-9]+",
        window_idx = r"[0-9]+",
        seed = r"[0-9]+",
    params:
        burn_in = 0,  # Relate is a single genealogy, with no MCMC warm-up
    resources:
        mem_mb = lambda wildcards, attempt: (12000 if wildcards.scenario in ROBUSTNESS_DENSE_SCENARIOS else 6000) * attempt,
        runtime = lambda wildcards, attempt: 60 * attempt,
    conda:
        "envs/bench.yml"
    script:
        "scripts/score_arg_shard.py"


