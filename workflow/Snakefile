    samples=20, length=2_000_000, mu=1e-8,
    rec_rate=1e-8, pop_size=1e4, seed=42,
)
ESTSFS_CONFIG = dict(
    # 2 Mb gives the fit ~10 k polymorphic sites, enough that the n_out=2
    # MLE stays off the K_1 = 1e-9 boundary.
    n_ingroup=40, length=2_000_000, mu=1e-8,
    rec_rate=1e-8, pop_size=1e4, outgroup_pop_size=1e5,
    outgroup_divergences=[5e4, 1e5, 1.5e5],  # closest first; len == n_outgroup
    seed=42, model="JC",
)
ESTSFS_PRIORS = ["kingman", "adaptive"]
ESTSFS_MODELS = ["JC", "K2", "R6"]
# fastDFE's est-sfs wrapper only supports JC + K2 (no R6 implementation),
# so the fastdfe-side report cells skip R6 and the comparison omits that
# column for the R6 row.
ESTSFS_FASTDFE_MODELS = ["JC", "K2"]
ESTSFS_N_OUTS = [1, 2, 3]  # n_out=k subsets to the closest k outgroups
# {sim} name → mutation-model spec passed to ``simulate_estsfs.py``.
# - ``jc``    : HKY κ=1 (Kimura-symmetric, no Ts/Tv bias)
# - ``hky2``  : HKY κ=2 (realistic per-site Ts/Tv ratio for vertebrate genomes)
# - ``gtr``   : msprime GTR with transition-biased exchangeability rates
#               (r_AG=r_CT=4, transversions=1) and skewed equilibrium
#               frequencies π = (0.3, 0.2, 0.2, 0.3). This is the only
#               sim that breaks BOTH the uniform-pi assumption (which JC
#               and K2 share) AND treats every rate as a free parameter
#               (which only the R6/GTR fit accommodates).
ESTSFS_SIMS = {
    "jc":    {"model": "HKY", "kappa": 1.0},
    "hky2":  {"model": "HKY", "kappa": 2.0},
    "gtr":   {
        "model": "GTR",
        "rates": [1.0, 4.0, 1.0, 1.0, 4.0, 1.0],
        "pi":    [0.3, 0.2, 0.2, 0.3],
    },
}

