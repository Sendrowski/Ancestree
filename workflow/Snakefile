)
POLYTOMY_THRESHOLDS = [0, 100, 500, 1000, 5000, 10000, 50000]

# Outgroup-effect benchmark: ARGInference posterior certainty and
# accuracy as a function of how many outgroups the local tree includes.
# Same ARG, simplified down to ingroup + first ``n_out`` outgroups each run.
OUTGROUP_EFFECT_CONFIG = dict(
    # Mirrors PolarBEAR's published simulation parameters
    # (constant_pop_size.py): same Ne across all populations, deep
    # outgroup splits at ~human-chimp / -gorilla / -orangutan scale,
    # PolarBEAR's mu = 1.25e-8. Filtering to ingroup-polymorphic sites
    # (as PolarBEAR's accuracy script does too) affords the deeper splits
    # without the metric being swamped by outgroup-private singletons.
    # The sequence is shorter than PolarBEAR's 10 Mb to keep the run short.
    n_ingroup=20, n_outgroup_pops=3,
    length=5e6, mu=1.25e-8, rec_rate=1e-8,
    pop_size=3e4, ingroup_pop_size=3e4,
    outgroup_split_times=[3e5, 9e5, 1.5e6],
    seed=42,
)
OUTGROUP_EFFECT_N_OUTS = [0, 1, 2, 3]
# Robustness-heatmap baseline with a 10-rung outgroup ladder (first 3
# depths match OUTGROUP_EFFECT_CONFIG, then 7 deeper) so the heatmap can
# show an n_out=10 row for ARG mode. A separate simulation from the
# 3-outgroup outgroup-effect benchmark.
OUTGROUP_EFFECT10_CONFIG = dict(
    n_ingroup=20, n_outgroup_pops=10,
    length=1e7, mu=1.25e-8, rec_rate=1e-8,  # unified with the other robustness scenarios
    pop_size=3e4, ingroup_pop_size=3e4,
    # Geometric ladder within a realistic depth window [3e5, 1.5e6]
    # (~1.9% max divergence, human-ape/primate scale). 10 outgroups
    # necessarily means narrow spacing. The ladder is not extended deeper:
    # that would be unrealistically diverged and JC-saturated, and would
    # inflate the n_out=10 fixed-class gain artificially.
    outgroup_split_times=[3.0e5, 3.6e5, 4.3e5, 5.1e5, 6.1e5,
                          7.3e5, 8.8e5, 1.05e6, 1.25e6, 1.5e6],
    seed=42,
)
# CpG-hypermutability scenario: same realistic 10-outgroup ladder, but a
# CpG-scale mutation rate (~10× the genome average), which produces many
# recurrent / multiple-hit sites (homoplasy) and so stresses the ≥2-mut
# column.
CPG_HYPERMUT_CONFIG = dict(
    n_ingroup=20, n_outgroup_pops=10,
    length=1e7, mu=1.25e-7, rec_rate=1e-8,  # 10× sites for smoother Fig 4 spectra
    pop_size=3e4, ingroup_pop_size=3e4,
    outgroup_split_times=[3.0e5, 3.6e5, 4.3e5, 5.1e5, 6.1e5,
                          7.3e5, 8.8e5, 1.05e6, 1.25e6, 1.5e6],
    seed=42,
)
# Resimulation variant: 20 independent seeds of the same demographic.
# Aggregate per (n_out, seed) since site sets differ between sims.
OUTGROUP_EFFECT_RESIM_SEEDS = list(range(100, 120))

# Strong-perturbation siblings of OUTGROUP_EFFECT used by the robustness
# heatmap (workflow/scripts/make_robustness_heatmap.py). Both share the
# outgroup-effect simulator script, differing only in the outgroup split
# times and length. ``strong_ils``: shallow splits at the ingroup TMRCA
# scale → heavy ILS.
STRONG_ILS_CONFIG = dict(
    n_ingroup=20, n_outgroup_pops=10,
    length=1e7, mu=1.25e-8, rec_rate=1e-8,  # 10× sites for smoother Fig 4 spectra
    pop_size=3e4, ingroup_pop_size=3e4,
    # Shallow, tightly-spaced ladder → heavy ILS. The deeper rungs feed the
    # n_out=10 row.
    outgroup_split_times=[3e4, 5e4, 7e4, 9e4, 1.1e5,
                          1.3e5, 1.5e5, 1.7e5, 1.9e5, 2.1e5],
    seed=42,
)
# Outgroup-clade scenario: the outgroups coalesce with each other before
# the whole clade joins the ingroup (3e5 gen), a serious breach of
# FixedTreeInference's outgroup-ladder assumption.
OUTGROUP_CLADE_CONFIG = dict(
    n_ingroup=20, n_outgroup_pops=10,
    length=1e7, mu=1.25e-8, rec_rate=1e-8,  # 10× sites for smoother Fig 4 spectra
    pop_size=3e4, ingroup_pop_size=3e4,
    # n-1 among-outgroup coalescences (caterpillar clade), all strictly
    # shallower than the deep ingroup↔clade split.
    among_outgroup_times=[5e4, 7e4, 9e4, 1.1e5, 1.3e5,
                          1.5e5, 1.7e5, 1.9e5, 2.1e5],
    ingroup_outgroup_split=3e5,
    seed=42,
)
# Demographic-distortion scenarios: the baseline outgroup ladder with a recent
# exponential ingroup size change over a 1.2e5-gen epoch, pinned to a constant
# ancestral size before that (a bounded 10× ratio, so msprime never stalls).
# growth_rate > 0 is forward growth (excess rare variants) and < 0 forward
# decline (enriched high-frequency derived tail). g = ±ln(10)/1.2e5. Used by
# the adaptive-vs-Kingman prior comparison and the decline row of the
# fractional-SFS figure.
