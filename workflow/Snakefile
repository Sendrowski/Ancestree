rule report_focal_interpolation_ensemble_shard:
    """The local-tree mode again, with the likelihood marginalised over B
    genealogies drawn from the pairwise HMM's posterior. One job per outgroup
    count: the draws do not depend on the focal position, so each panel's
    ensemble is built once and re-rooted across the whole grid."""
    input:
        trees = f"{DATA}/baseline10_chunk0.trees",
    output:
        json = f"{REPORTS}/focal_ens_shard_n{{n_out}}.json",
        diagnostics = f"{REPORTS}/focal_ens_shard_n{{n_out}}_diagnostics.json",
    wildcard_constraints:
        n_out = r"|".join(str(n) for n in FOCAL_N_OUTS),
    params:
        fractions = FOCAL_FRACTIONS,
        mu = 1.25e-8,
        rec_rate = 1e-8,
        window = "8snp",
        n_members = 128,
        n_subsets = 4,
        member_chunk = 8,
        seed = 1000,
    resources:
        mem_mb = 32000,
        runtime = 240,
    conda:
        "envs/bench.yml"
    script:
        "scripts/report_focal_interpolation_ensemble.py"


rule report_focal_interpolation_ensemble:
    """Concatenate the per-outgroup ensemble shards."""
    input:
        json = expand(f"{REPORTS}/focal_ens_shard_n{{n_out}}.json",
                      n_out=FOCAL_N_OUTS),
        diagnostics = expand(
            f"{REPORTS}/focal_ens_shard_n{{n_out}}_diagnostics.json",
            n_out=FOCAL_N_OUTS),
    output:
        json = f"{REPORTS}/focal_interpolation_local_tree_ens.json",
        diagnostics = (f"{REPORTS}/"
                       "focal_interpolation_local_tree_ens_diagnostics.json"),
    resources:
        mem_mb = 4000,
        runtime = 20,
    run:
        import json as _json
        for shards, target in ((input.json, output.json),
                               (input.diagnostics, output.diagnostics)):
            rows, meta = [], {}
            for path in shards:
                with open(path) as handle:
                    payload = _json.load(handle)
                rows.extend(payload["rows"])
                meta = {k: v for k, v in payload.items()
                        if k not in ("rows", "n_out")}
            with open(target, "w") as handle:
                _json.dump({**meta, "rows": rows}, handle, indent=1)


rule report_focal_interpolation:
    input:
        shards = expand(
            f"{REPORTS}/focal_interpolation_{{mode}}_n{{n_out}}.json",
            mode=FOCAL_MODES, n_out=FOCAL_N_OUTS,
        ),
        ensemble = f"{REPORTS}/focal_interpolation_local_tree_ens.json",
    output:
        json = f"{REPORTS}/focal_interpolation.json",
    run:
        import json as _json
        rows, meta = [], {}
        for path in input.shards:
            with open(path) as handle:
                payload = _json.load(handle)
            rows.extend(payload["rows"])
            meta = {k: v for k, v in payload.items() if k != "rows"}
        with open(input.ensemble) as handle:
            rows.extend(_json.load(handle)["rows"])
        with open(output.json, "w") as handle:
            _json.dump({**meta, "rows": rows}, handle, indent=1)


