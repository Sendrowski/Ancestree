# -------- outgroup-divergence grid (ARG + fixed-tree + local-tree)

# Wildcard ``{depth}`` is a free-form scientific-notation float string like
# ``"1.5e6"``, constrained so snakemake does not parse the ``s{spacing}``
# suffix as part of the depth pattern.
rule simulate_outgroup_divergence:
    """msprime ARG with ingroup + 3 outgroups at one ``(depth, spacing)`` cell."""
    output:
        trees = f"{DATA}/outgroup_divergence_sim_d{{depth}}_s{{spacing}}.trees",
        meta = f"{DATA}/outgroup_divergence_sim_d{{depth}}_s{{spacing}}_meta.json",
    params:
        **OUTGROUP_DIVERGENCE_CONFIG,
    wildcard_constraints:
        depth=r"[0-9.eE+-]+",
        spacing=r"|".join(OUTGROUP_DIVERGENCE_SPACINGS),
    conda:
        "envs/bench.yml"
    script:
        "scripts/simulate_outgroup_divergence.py"


rule infer_outgroup_divergence_arg:
    """ARGBasedInference on the (depth, spacing) sim, all 3 outgroups exposed."""
    input:
        trees = rules.simulate_outgroup_divergence.output.trees,
        meta = rules.simulate_outgroup_divergence.output.meta,
    output:
        f"{DATA}/outgroup_divergence_arg_d{{depth}}_s{{spacing}}_n{{n_out}}.json",
    params:
        mu = OUTGROUP_DIVERGENCE_CONFIG["mu"],
    wildcard_constraints:
        depth=r"[0-9.eE+-]+",
        spacing=r"|".join(OUTGROUP_DIVERGENCE_SPACINGS),
        n_out=r"[123]",
    conda:
        "envs/bench.yml"
    script:
        "scripts/infer_outgroup_divergence_arg.py"


rule infer_outgroup_divergence_vcf:
    """FixedTreeInference on the (depth, spacing) sim, all 3 outgroups in the ladder."""
    input:
        trees = rules.simulate_outgroup_divergence.output.trees,
        meta = rules.simulate_outgroup_divergence.output.meta,
    output:
        f"{DATA}/outgroup_divergence_vcf_d{{depth}}_s{{spacing}}_n{{n_out}}.json",
    params:
        mu = OUTGROUP_DIVERGENCE_CONFIG["mu"],
    wildcard_constraints:
        depth=r"[0-9.eE+-]+",
        spacing=r"|".join(OUTGROUP_DIVERGENCE_SPACINGS),
        n_out=r"[123]",
    conda:
        "envs/bench.yml"
    script:
        "scripts/infer_outgroup_divergence_vcf.py"


rule infer_outgroup_divergence_local_tree:
    """LocalTreeInference on the (depth, spacing) sim, trees inferred from genotypes."""
    input:
        trees = rules.simulate_outgroup_divergence.output.trees,
        meta = rules.simulate_outgroup_divergence.output.meta,
    output:
        f"{DATA}/outgroup_divergence_local_tree_d{{depth}}_s{{spacing}}_n{{n_out}}.json",
    params:
        mu = OUTGROUP_DIVERGENCE_CONFIG["mu"],
    wildcard_constraints:
        depth=r"[0-9.eE+-]+",
        spacing=r"|".join(OUTGROUP_DIVERGENCE_SPACINGS),
        n_out=r"[123]",
    threads: 8
    resources:
        # The pairwise HMM plus a 128-member ensemble over a 1 Mb region is far
        # heavier than the ARG and fixed-tree cells, which run on the default
        # resources, so this rule carries its own attempt-scaled budget.
        mem_mb = lambda wildcards, attempt: 32000 * attempt,
        runtime = lambda wildcards, attempt: capped_runtime(360, attempt),
    conda:
        "envs/bench.yml"
    script:
        "scripts/infer_outgroup_divergence_local_tree.py"


rule report_outgroup_divergence:
    """Aggregate the {arg,vcf,local_tree} cells → outgroup_divergence.{json,md}.

    Standalone target, not part of ``rule all``. Build with::

        snakemake -j 1 report_outgroup_divergence
    """
    input:
        arg_cells = expand(
            f"{DATA}/outgroup_divergence_arg_d{{depth}}_s{{spacing}}_n{{n_out}}.json",
            depth=OUTGROUP_DIVERGENCE_DEPTHS,
            spacing=OUTGROUP_DIVERGENCE_SPACINGS,
            n_out=OUTGROUP_DIVERGENCE_N_OUTS,
        ),
        vcf_cells = expand(
            f"{DATA}/outgroup_divergence_vcf_d{{depth}}_s{{spacing}}_n{{n_out}}.json",
            depth=OUTGROUP_DIVERGENCE_DEPTHS,
            spacing=OUTGROUP_DIVERGENCE_SPACINGS,
            n_out=OUTGROUP_DIVERGENCE_N_OUTS,
        ),
        local_tree_cells = expand(
            f"{DATA}/outgroup_divergence_local_tree_d{{depth}}_s{{spacing}}_n{{n_out}}.json",
            depth=OUTGROUP_DIVERGENCE_DEPTHS,
            spacing=OUTGROUP_DIVERGENCE_SPACINGS,
            n_out=OUTGROUP_DIVERGENCE_N_OUTS,
        ),
    output:
        json = f"{REPORTS}/outgroup_divergence.json",
        md = f"{REPORTS}/outgroup_divergence.md",
    params:
        sim_config = {
            **OUTGROUP_DIVERGENCE_CONFIG,
            "depths": OUTGROUP_DIVERGENCE_DEPTHS,
            "spacings": OUTGROUP_DIVERGENCE_SPACINGS,
            "n_outs": OUTGROUP_DIVERGENCE_N_OUTS,
        },
        depths = OUTGROUP_DIVERGENCE_DEPTHS,
        spacings = OUTGROUP_DIVERGENCE_SPACINGS,
        n_outs = OUTGROUP_DIVERGENCE_N_OUTS,
    conda:
        "envs/bench.yml"
    script:
        "scripts/report_outgroup_divergence.py"



