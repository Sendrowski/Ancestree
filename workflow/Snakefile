# ----------------------------- SLiM outgroup-bias validation
# Forward-time SLiM simulation of the 4-population demography (ingroup p0 +
# three nested outgroups), then FixedTreeInference under 1/2/3 outgroups, in
# ``SLIM_OUTGROUP_BIAS_N_CHUNKS`` independent chunks seeded base_seed +
# chunk_idx. Rescaled to N_e_slim by s = Ne_target / Ne_slim: T_slim = T / s,
# mu_slim = mu * s, rho_slim = rho * s, leaving theta = 4·Ne·mu and K = mu·T
# invariant. Build via ``snakemake -j 8 report_slim_outgroup_bias``.
SLIM_OUTGROUP_BIAS_CONFIG = dict(
    # Shallow regime (human-ape scale, K = 0.004 / 0.011 / 0.019) with the
    # outgroup-effect spacing. Deep-regime swap: seq_len_total = 100_000,
    # N_e_slim = 100, outgroup_split_times_target = [4e6, 8e6, 12e6] for
    # the EST-SFS K = 0.05/0.10/0.15 cell.
    seq_len_total=1_000_000,
    mu_target=1.25e-8,
    rec_rate_target=1e-8,
    Ne_target=10_000,
    N_e_slim=1_000,
    N_e_outgroup_slim=5,
    outgroup_split_times_target=[3e5, 9e5, 1.5e6],
    n_ingroup_haps=20,
    seed=42,
)
SLIM_OUTGROUP_BIAS_N_CHUNKS = 10
SLIM_OUTGROUP_BIAS_CHUNK_IDXS = list(range(SLIM_OUTGROUP_BIAS_N_CHUNKS))
SLIM_OUTGROUP_BIAS_F_DELS = ["0.0", "0.5", "1.0"]
SLIM_OUTGROUP_BIAS_N_OUTS = [1, 2, 3]

# Derived constants (kept here so both Snakefile + scripts read the same
# scaling). s = Ne_target / Ne_slim.
SLIM_OUTGROUP_BIAS_TIME_SCALING = (
    SLIM_OUTGROUP_BIAS_CONFIG["Ne_target"] / SLIM_OUTGROUP_BIAS_CONFIG["N_e_slim"]
)
SLIM_OUTGROUP_BIAS_MU_SLIM = (
    SLIM_OUTGROUP_BIAS_CONFIG["mu_target"] * SLIM_OUTGROUP_BIAS_TIME_SCALING
)
SLIM_OUTGROUP_BIAS_RHO_SLIM = (
    SLIM_OUTGROUP_BIAS_CONFIG["rec_rate_target"] * SLIM_OUTGROUP_BIAS_TIME_SCALING
)
SLIM_OUTGROUP_BIAS_T_SLIM = [
    int(t / SLIM_OUTGROUP_BIAS_TIME_SCALING)
    for t in SLIM_OUTGROUP_BIAS_CONFIG["outgroup_split_times_target"]
]
SLIM_OUTGROUP_BIAS_SEQ_LEN_PER_CHUNK = (
    SLIM_OUTGROUP_BIAS_CONFIG["seq_len_total"] // SLIM_OUTGROUP_BIAS_N_CHUNKS
)

# ----- Separate 10-outgroup SLiM sim for the robustness heatmap only.
# Same scaling as the 3-outgroup sim, with a geometric 10-rung ladder within
# a realistic depth window [3e5, 1.5e6] (~1.9% max divergence, no JC
# saturation). 10× the total sequence over SLIM10_N_CHUNKS=100 chunks of
# 100 kb each, so 10× more jobs at the same per-job runtime.
SLIM_OUTGROUP_BIAS10_CONFIG = dict(
    seq_len_total=10_000_000,
    mu_target=1.25e-8,
    rec_rate_target=1e-8,
    Ne_target=10_000,
    N_e_slim=1_000,
    N_e_outgroup_slim=5,
    outgroup_split_times_target=[3.0e5, 3.6e5, 4.3e5, 5.1e5, 6.1e5,
                                 7.3e5, 8.8e5, 1.05e6, 1.25e6, 1.5e6],
    n_ingroup_haps=20,
    seed=42,
)
SLIM10_TIME_SCALING = (
    SLIM_OUTGROUP_BIAS10_CONFIG["Ne_target"]
    / SLIM_OUTGROUP_BIAS10_CONFIG["N_e_slim"]
)
SLIM10_MU_SLIM = SLIM_OUTGROUP_BIAS10_CONFIG["mu_target"] * SLIM10_TIME_SCALING
SLIM10_RHO_SLIM = (
    SLIM_OUTGROUP_BIAS10_CONFIG["rec_rate_target"] * SLIM10_TIME_SCALING
)
SLIM10_T_SLIM = [
    int(t / SLIM10_TIME_SCALING)
    for t in SLIM_OUTGROUP_BIAS10_CONFIG["outgroup_split_times_target"]
]
SLIM10_SPLITS_STR = "c(" + ",".join(str(t) for t in SLIM10_T_SLIM) + ")"
SLIM10_SPLITS_TARGET_STR = " ".join(
    str(t) for t in SLIM_OUTGROUP_BIAS10_CONFIG["outgroup_split_times_target"]
)
SLIM10_N_OUT = len(SLIM_OUTGROUP_BIAS10_CONFIG["outgroup_split_times_target"])
# Robustness SLiM chunk count, decoupled from the est-sfs cell's
# SLIM_OUTGROUP_BIAS_N_CHUNKS: 10× sites over 100 chunks, so each chunk is
# 100 kb, the est-sfs cell's per-chunk size. Drives both the per-chunk
# seq_len here and ROBUSTNESS_SLIM_CHUNKS.
SLIM10_N_CHUNKS = 100
SLIM10_SEQ_LEN_PER_CHUNK = (
    SLIM_OUTGROUP_BIAS10_CONFIG["seq_len_total"] // SLIM10_N_CHUNKS
)


rule simulate_slim_outgroup_bias:
    """SLiM forward sim of the 4-population demography for one chunk.

    Wildcards:

    - ``{chunk_idx}`` ∈ ``0..N_CHUNKS-1``: chunk seed offset (per-chunk
      seed = base_seed + chunk_idx), each chunk is an independent
      ``seq_len_per_chunk``-bp sim.
    - ``{f_del}`` ∈ ``{0.0, 0.5, 1.0}``: fraction of sites under the
      gamma DFE in the mosaic layout (rest strictly neutral).

    Output: a 4-population tree sequence with ingroup p0 + outgroups
    p1/p2/p3 already split at the configured (rescaled) times. The
    recap+mutate stage handles the deep coalescent above T3 and overlays
    JC69 mutations.

    Runs under ``workflow/envs/slim.yml`` (SLiM binary + pyslim).
    """
    output:
        trees = f"{DATA}/slim_outgroup_bias_fdel{{f_del}}_chunk{{chunk_idx}}_slim.trees",
    params:
        base_seed = SLIM_OUTGROUP_BIAS_CONFIG["seed"],
        seq_len = SLIM_OUTGROUP_BIAS_SEQ_LEN_PER_CHUNK,
        mu_slim = SLIM_OUTGROUP_BIAS_MU_SLIM,
        rho_slim = SLIM_OUTGROUP_BIAS_RHO_SLIM,
        N_e_slim = SLIM_OUTGROUP_BIAS_CONFIG["N_e_slim"],
        N_e_out = SLIM_OUTGROUP_BIAS_CONFIG["N_e_outgroup_slim"],
        T1_slim = SLIM_OUTGROUP_BIAS_T_SLIM[0],
        T2_slim = SLIM_OUTGROUP_BIAS_T_SLIM[1],
        T3_slim = SLIM_OUTGROUP_BIAS_T_SLIM[2],
        script = f"{SCRIPTS}/simulate_slim_outgroup_bias.slim",
    wildcard_constraints:
        f_del = r"[0-9.]+",
        chunk_idx = r"[0-9]+",
    resources:
        mem_mb = lambda wildcards, attempt: 16000 * attempt,
        runtime = lambda wildcards, attempt: capped_runtime(480, attempt),
    conda:
        "envs/slim.yml"
    shell:
        "slim "
        '-d "SEED=$(({params.base_seed} + {wildcards.chunk_idx}))" '
        '-d "F_DEL={wildcards.f_del}" '
        '-d "SEQ_LEN={params.seq_len}" '
        '-d "MU_SLIM={params.mu_slim}" '
        '-d "RHO_SLIM={params.rho_slim}" '
        '-d "N_E_SLIM={params.N_e_slim}" '
        '-d "N_E_OUT={params.N_e_out}" '
        '-d "T1_SLIM={params.T1_slim}" '
        '-d "T2_SLIM={params.T2_slim}" '
        '-d "T3_SLIM={params.T3_slim}" '
        "-d \"OUT_TREES='{output.trees}'\" "
        "{params.script}"


rule recap_and_mutate_slim_outgroup_bias:
    """Recapitate the 4-pop SLiM ts, overlay JC69 mutations, write
    VCF + meta. One cell per ``(chunk_idx, f_del)``.

    The SLiM stage produces the full demography with nested outgroup
    splits, so this step is purely the deep-coalescent extension + JC69
    overlay + sample selection.

    Runs under ``workflow/envs/slim.yml`` (pyslim + msprime).
    """
    input:
        slim_trees = rules.simulate_slim_outgroup_bias.output.trees,
    output:
        trees = f"{DATA}/slim_outgroup_bias_fdel{{f_del}}_chunk{{chunk_idx}}.trees",
        vcf = f"{DATA}/slim_outgroup_bias_fdel{{f_del}}_chunk{{chunk_idx}}.vcf",
        meta = f"{DATA}/slim_outgroup_bias_fdel{{f_del}}_chunk{{chunk_idx}}_meta.json",
    params:
        seed = SLIM_OUTGROUP_BIAS_CONFIG["seed"],
        mu_slim = SLIM_OUTGROUP_BIAS_MU_SLIM,
        rec_rate_slim = SLIM_OUTGROUP_BIAS_RHO_SLIM,
        N_e_slim = SLIM_OUTGROUP_BIAS_CONFIG["N_e_slim"],
        mu_target = SLIM_OUTGROUP_BIAS_CONFIG["mu_target"],
        time_scaling = SLIM_OUTGROUP_BIAS_TIME_SCALING,
        outgroup_split_times_target = SLIM_OUTGROUP_BIAS_CONFIG["outgroup_split_times_target"],
        n_ingroup_haps = SLIM_OUTGROUP_BIAS_CONFIG["n_ingroup_haps"],
        seq_len = SLIM_OUTGROUP_BIAS_SEQ_LEN_PER_CHUNK,
    wildcard_constraints:
        f_del = r"[0-9.]+",
        chunk_idx = r"[0-9]+",
    conda:
        "envs/slim.yml"
    script:
        "scripts/recap_and_mutate_slim_outgroup_bias.py"


rule fit_slim_outgroup_bias:
    """Joint FixedTreeInference fit pooling all chunk VCFs for one
    ``(f_del, n_out)`` cell.

    Per-chunk MLEs at ~5 k polymorphic sites overfit per-chunk sampling
    noise (collapsing to the K_1 = 1e-9 boundary), so one ``.fit()`` per
    ``(f_del, n_out)`` consumes the polymorphic-site streams of all 10
    chunks. The downstream ``infer_slim_outgroup_bias`` rule then reads
    the joint fit JSON and runs the per-chunk per-site posterior pass with
    the rates locked.

    Runs under ``workflow/envs/bench.yml``.
    """
    input:
        vcfs = expand(
            f"{DATA}/slim_outgroup_bias_fdel{{{{f_del}}}}_chunk{{chunk_idx}}.vcf",
            chunk_idx=SLIM_OUTGROUP_BIAS_CHUNK_IDXS,
        ),
        metas = expand(
            f"{DATA}/slim_outgroup_bias_fdel{{{{f_del}}}}_chunk{{chunk_idx}}_meta.json",
            chunk_idx=SLIM_OUTGROUP_BIAS_CHUNK_IDXS,
        ),
    output:
        fit = f"{DATA}/slim_outgroup_bias_fdel{{f_del}}_n{{n_out}}_fit.json",
    params:
        # Cumulative target sequence length across chunks. Used by the
        # joint-fit's monomorphic-site calibration: n_target_sites = sum
        # of per-chunk seq_len_per_chunk = the full sim sequence length.
        length = (
            SLIM_OUTGROUP_BIAS_SEQ_LEN_PER_CHUNK
            * SLIM_OUTGROUP_BIAS_N_CHUNKS
        ),
    wildcard_constraints:
        f_del = r"[0-9.]+",
        n_out = r"[0-9]+",
    conda:
        "envs/bench.yml"
    script:
        "scripts/fit_slim_outgroup_bias.py"


rule infer_slim_outgroup_bias:
    """Per-chunk posterior pass using the joint fit's parameters.

    Reads one chunk's VCF + meta plus the joint-fit JSON for the matching
    ``(f_del, n_out)`` cell, locks ``FixedTreeInference``'s branch rates
    to the joint MLE (``fit_required=False`` + manual
    ``tree.set_params``), and streams per-site posteriors. ``fit_seconds``
    is 0 in the output (the fit happens upstream once per cell), and the
    joint fit's wall-time + kappa / K MLE are passed through under
    ``joint_fit_seconds`` / ``joint_fit_kappa_mle`` / ``joint_fit_K_mle``.
    """
    input:
        vcf = rules.recap_and_mutate_slim_outgroup_bias.output.vcf,
        meta = rules.recap_and_mutate_slim_outgroup_bias.output.meta,
        fit = rules.fit_slim_outgroup_bias.output.fit,
    output:
        f"{DATA}/slim_outgroup_bias_fdel{{f_del}}_chunk{{chunk_idx}}_n{{n_out}}.json",
    params:
        length = SLIM_OUTGROUP_BIAS_SEQ_LEN_PER_CHUNK,
    wildcard_constraints:
        f_del = r"[0-9.]+",
        chunk_idx = r"[0-9]+",
        n_out = r"[0-9]+",
    conda:
        "envs/bench.yml"
    script:
        "scripts/infer_slim_outgroup_bias.py"


rule infer_slim_outgroup_bias_arg:
    """ARG-mode (true-ARG) inference on one ``(chunk_idx, f_del, n_out)`` cell.

    Loads the simulator-truth recap+mutate ts, simplifies to ingroup +
    first ``n_out`` outgroups (closest first), and runs
    :class:`ARGBasedInference` with JC69 + full recurrence. The
    branch-length scale is SLiM generations, so ``mu = mu_slim``
    matches K = mu * branch_length to the target scale.
    """
    input:
        trees = rules.recap_and_mutate_slim_outgroup_bias.output.trees,
        meta = rules.recap_and_mutate_slim_outgroup_bias.output.meta,
    output:
        f"{DATA}/slim_outgroup_bias_fdel{{f_del}}_chunk{{chunk_idx}}_arg_n{{n_out}}.json",
    params:
        mu_slim = SLIM_OUTGROUP_BIAS_MU_SLIM,
    wildcard_constraints:
        f_del = r"[0-9.]+",
        chunk_idx = r"[0-9]+",
        n_out = r"[0-9]+",
    conda:
        "envs/bench.yml"
    script:
        "scripts/infer_slim_outgroup_bias_arg.py"






# ============================================================ 10-outgroup SLiM
# Parallel set of rules writing ``slim_outgroup_bias10_*`` files for the
# robustness heatmap's n_out=10 SLiM column. Uses the N-agnostic recipe and
# the shared recap / infer scripts.

rule simulate_slim_outgroup_bias10:
    """10-outgroup SLiM forward sim for one chunk (robustness heatmap)."""
    output:
        trees = f"{DATA}/slim_outgroup_bias10_fdel{{f_del}}_chunk{{chunk_idx}}_slim.trees",
    params:
        base_seed = SLIM_OUTGROUP_BIAS10_CONFIG["seed"],
        seq_len = SLIM10_SEQ_LEN_PER_CHUNK,
        mu_slim = SLIM10_MU_SLIM,
        rho_slim = SLIM10_RHO_SLIM,
        N_e_slim = SLIM_OUTGROUP_BIAS10_CONFIG["N_e_slim"],
        N_e_out = SLIM_OUTGROUP_BIAS10_CONFIG["N_e_outgroup_slim"],
        n_out = SLIM10_N_OUT,
        splits_str = SLIM10_SPLITS_STR,
        script = f"{SCRIPTS}/simulate_slim_outgroup_bias_n.slim",
    wildcard_constraints:
        f_del = r"[0-9.]+",
        chunk_idx = r"[0-9]+",
    resources:
        mem_mb = lambda wildcards, attempt: 16000 * attempt,
        runtime = lambda wildcards, attempt: capped_runtime(480, attempt),
    conda:
        "envs/slim.yml"
    shell:
        "slim "
        '-d "SEED=$(({params.base_seed} + {wildcards.chunk_idx}))" '
        '-d "F_DEL={wildcards.f_del}" '
        '-d "SEQ_LEN={params.seq_len}" '
        '-d "MU_SLIM={params.mu_slim}" '
        '-d "RHO_SLIM={params.rho_slim}" '
        '-d "N_E_SLIM={params.N_e_slim}" '
        '-d "N_E_OUT={params.N_e_out}" '
        '-d "N_OUT={params.n_out}" '
        '-d "SPLITS_SLIM={params.splits_str}" '
        "-d \"OUT_TREES='{output.trees}'\" "
        "{params.script}"


