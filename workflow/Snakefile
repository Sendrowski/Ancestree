rule report_robustness_heatmap:
    """Render one heatmap figure + runtime side-table from the per-cell JSONs.

    One rule for all three heatmap figures (Figure 4, the ARG-inference
    comparison, the appendix baselines replica): they differ only in which
    method rows they show, so the row set is the ``{figure}`` wildcard. Every
    figure reads the intersection-scored cells, so all rows of all figures are
    graded on one identical site set (SINGER's budget prefix per chunk).

    Build with parallel cells, e.g.::

        snakemake -j 8 results/reports/robustness_heatmap.pdf
    """
    input:
        cells = lambda wc: expand(
            f"{DATA}/robustness_cell_intersect_{{scenario}}_{{method}}"
            f"_n{{n_out}}_summary.json",
            scenario=ROBUSTNESS_SCENARIOS,
            method=ROBUSTNESS_FIGURE_METHODS[wc.figure],
            n_out=ROBUSTNESS_N_OUTS,
        ),
    output:
        heatmap = f"{REPORTS}/{{figure}}.pdf",
        heatmap_map = f"{REPORTS}/{{figure}}_map.pdf",
        runtimes_json = f"{REPORTS}/{{figure}}_runtimes.json",
        runtimes_md = f"{REPORTS}/{{figure}}_runtimes.md",
        fig_copy = "reports/manuscripts/latex/figures/bench_{figure}.pdf",
    wildcard_constraints:
        figure = r"|".join(ROBUSTNESS_FIGURE_METHODS),
    resources:
        # Loads only the light per-cell summaries (a few KB each), so the
        # report fits in well under a GB.
        mem_mb = 6000,
        runtime = 240,
    conda:
        "envs/bench.yml"
    script:
        "scripts/make_robustness_heatmap.py"



# ---- Ensemble-mode cost: runtime and peak memory against the draw count ----

#: Grid of the ensemble scaling benchmark. Sharded one job per cell so the
#: measurements do not contend: each cell parallelises internally, so running
#: several at once would inflate every timing.
ENSEMBLE_SCALING_DRAWS = [1, 8, 32, 128, 512]
ENSEMBLE_SCALING_WORKERS = [1, 2, 4, 8]
ENSEMBLE_SCALING_INDIVIDUALS = 50
ENSEMBLE_SCALING_LENGTH = 2_000_000
#: Small enough that the panel splits into several segments, which is what
#: n_workers fans out. On the single-region path workers parallelise only the
#: Felsenstein pass, not the tree construction that dominates this mode.
ENSEMBLE_SCALING_CHUNK = "250kb"


rule bench_ensemble_scaling_cell:
    """One (draws, workers) cell of the ensemble cost grid."""
    output:
        f"{DATA}/ensemble_scaling_m{{n_ensemble}}_w{{n_workers}}.json",
    params:
        n_ensemble = lambda wc: int(wc.n_ensemble),
        n_workers = lambda wc: int(wc.n_workers),
        n_individuals = ENSEMBLE_SCALING_INDIVIDUALS,
        sequence_length = ENSEMBLE_SCALING_LENGTH,
        chunk_size = ENSEMBLE_SCALING_CHUNK,
        mu = 1.25e-8,
        rec_rate = 1e-8,
        seed = 3,
    wildcard_constraints:
        n_ensemble = r"[0-9]+",
        n_workers = r"[0-9]+",
    threads: lambda wc: int(wc.n_workers)
    resources:
        # Peak tracks the segment span and member_chunk, not the draw count,
        # but the pairwise stage grows with the square of the panel.
        mem_mb = 16000,
        runtime = 120,
    conda:
        "envs/bench.yml"
    script:
        "scripts/bench_ensemble_scaling.py"


rule ensemble_scaling_figure:
    """Runtime and peak memory against the number of ensemble draws."""
    input:
        expand(
            f"{DATA}/ensemble_scaling_m{{n_ensemble}}_w{{n_workers}}.json",
            n_ensemble=ENSEMBLE_SCALING_DRAWS,
            n_workers=ENSEMBLE_SCALING_WORKERS,
        ),
    output:
        pdf = f"{REPORTS}/ensemble_scaling.pdf",
        summary = f"{REPORTS}/ensemble_scaling.json",
    resources:
        mem_mb = 4000,
        runtime = 30,
    conda:
        "envs/bench.yml"
    script:
        "scripts/plot_ensemble_scaling.py"

rule ensemble_scaling_figure_copy:
    """The ensemble-scaling figure, in the manuscript's figure tree."""
    input:
        pdf = rules.ensemble_scaling_figure.output.pdf,
    output:
        fig_copy = "reports/manuscripts/latex/figures/ensemble_scaling.pdf",
    shell:
        "cp {input.pdf} {output.fig_copy}"


