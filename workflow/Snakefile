    "outgroup_clade": "outgroup_clade",
    "pop_constant": "pop_constant",
    "pop_growth": "pop_growth",
    "pop_decline": "pop_decline",
}
# Demographic-distortion scenarios share the chunked-msprime pipeline but stay
