    """msprime ARG + matching VCF for the PolarBEAR comparison."""
    output:
        trees = f"{DATA}/polarbear_sim.trees",
        vcf = f"{DATA}/polarbear_sim.vcf",
    params:
        **POLARBEAR_CONFIG,
    conda:
        "envs/bench.yml"
    script:
        "scripts/simulate_polarbear.py"


rule infer_polarbear_ancestree:
    """Ancestree on the simulated ARG (JC69 + full + uniform)."""
    input:
        trees = rules.simulate_polarbear.output.trees,
    output:
        f"{DATA}/polarbear_ancestree.json",
    params:
        mu = POLARBEAR_CONFIG["mu"],
    conda:
        "envs/bench.yml"
    script:
        "scripts/infer_polarbear_ancestree.py"


rule infer_polarbear_baseline:
    """PolarBEAR baseline in its own ``envs/polarbear.yml`` conda env.

    The script imports PolarBEAR directly. The dedicated env isolates its
    strict ``tskit==0.6 + numba`` pin stack from the rest of the pipeline.
    """
    input:
        trees = rules.simulate_polarbear.output.trees,
        vcf = rules.simulate_polarbear.output.vcf,
        # An input rather than a params path, so fetch_polarbear enters the
        # DAG.
        polarbear_script = "external/polarbear/code/polarize/site_polarize.py",
    output:
        f"{DATA}/polarbear_baseline.json",
    params:
        mu = POLARBEAR_CONFIG["mu"],
        polarbear_src = "external/polarbear/code/polarize",
    conda:
        "envs/polarbear.yml"
    script:
        "scripts/infer_polarbear_baseline.py"


rule report_polarbear:
    """Aggregate Ancestree + PolarBEAR posteriors → polarbear_agreement.{json,md}."""
    input:
        ancestree = rules.infer_polarbear_ancestree.output[0],
        polarbear = rules.infer_polarbear_baseline.output[0],
        trees = rules.simulate_polarbear.output.trees,
    output:
        json = f"{REPORTS}/polarbear_agreement.json",
        md = f"{REPORTS}/polarbear_agreement.md",
    params:
        sim_config = POLARBEAR_CONFIG,
    conda:
        "envs/bench.yml"
    script:
        "scripts/report_polarbear.py"


# ----------------------------------------------------- est-sfs comparison

rule simulate_estsfs:
    """msprime ARG, one per {sim} mutation-model spec.

    Wildcard ``{sim}`` ∈ ``ESTSFS_SIMS`` selects the mutation model
    (HKY κ or GTR rates+π). Same demography across sims, only the
    substitution model differs.
    """
    output:
        trees = f"{DATA}/estsfs_sim_{{sim}}.trees",
        vcf = f"{DATA}/estsfs_sim_{{sim}}.vcf",
        fasta = f"{DATA}/estsfs_sim_{{sim}}.fasta",
        meta = f"{DATA}/estsfs_sim_{{sim}}_meta.json",
    params:
        **ESTSFS_CONFIG,
        sim_spec = lambda wc: ESTSFS_SIMS[wc.sim],
    conda:
        "envs/bench.yml"
    script:
        "scripts/simulate_estsfs.py"


