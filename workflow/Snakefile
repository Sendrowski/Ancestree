# ------------------- Robustness heatmap (methods × n_out × scenarios)
#
# Each (scenario, method, n_out) is its own job (score_robustness_cell),
# so `snakemake -jN report_robustness_heatmap` fans the per-cell
# inference out across cores. The report stage aggregates the per-cell
# JSONs into the two heatmap PDFs + the runtime side-table.

ROBUSTNESS_SCENARIOS = [
    "baseline", "cpg_hypermut", "strong_ils", "outgroup_clade", "slim",
]
# Dense scenarios (millions of segregating sites: baseline ~5.9M,
# cpg_hypermut ~7.2M) drive per-cell memory/time. The rest are ~300K sites.
# Used to size resources below.
ROBUSTNESS_DENSE_SCENARIOS = {"baseline", "cpg_hypermut"}
# Appendix-only baseline methods. Share the score_robustness_cell rule +
# scoring engine, computed live per cell (no extra per-chunk SLiM dep beyond
# the metas).
ROBUSTNESS_BASELINE_METHODS = [
    "anc_ft_adaptive", "anc_ft_uniform", "parsimony_mu0",
    "majority_outgroup",
]
# Methods the all-sites per-cell rule builds. These cells feed the appendix
# figures that read scores over every site (the prior comparison, the SFS
# reconstructions). Local-tree mode is deliberately absent: it is scored only
# on the common covered set, through rule robustness_intersect_cell.
ROBUSTNESS_ALL_METHODS = ["anc_arg", "anc_ft"] + ROBUSTNESS_BASELINE_METHODS
ROBUSTNESS_N_OUTS = [0, 1, 3, 10]
# SLiM aggregation reads the pre-computed forward-sim chunks (SLIM10_N_CHUNKS).
ROBUSTNESS_SLIM_CHUNKS = list(range(SLIM10_N_CHUNKS))

# ---- SINGER baseline rows (sharded: budget window x MCMC chain) ------------
# SINGER is a full Bayesian ARG MCMC, so each chunk is subsampled to one window
# of ~SINGER_PANEL_SITE_BUDGET ingroup-segregating sites, fanned out over
# SINGER_N_CHAINS chains (seeds) and merged into a per-chunk summary. Both
# methods feed the outgroups into SINGER's sample panel, and the _ft variant
# additionally orients SINGER with the fixed-tree MAP estimate. Kept out of
# ROBUSTNESS_ALL_METHODS so the general chunk/cell wildcards do not match them.
SINGER_METHODS = ["singer_arg_panel", "singer_arg_panel_ft"]
SINGER_SCENARIOS = CHUNKED_MSP_SCENARIOS + ["slim"]
SINGER_DIR = os.environ.get("SINGER_DIR", str(Path.home() / "opt" / "singer"))
SINGER_N_CHAINS = int(os.environ.get("SINGER_N_CHAINS", "13"))
# MCMC length per chain, passed as rule params so jobs are reproducible and do
# not depend on the SLURM env forwarding these.
SINGER_N_ITERS = int(os.environ.get("SINGER_N_ITERS", "300"))
SINGER_THIN = int(os.environ.get("SINGER_THIN", "20"))
#: Wall-clock ceiling of the partition every rule is pinned to
#: (``slurm_partition="short"`` in workflow/profiles/slurm/config.yaml, where sinfo
#: reports 12:00:00). A retry that escalates past this is rejected at SUBMIT,
#: so the --restart-times path silently stops working for exactly the rules
#: that are slow enough to need it.
SHORT_PARTITION_MINUTES = 720


def capped_runtime(base_minutes, attempt):
    """``base_minutes * attempt``, held at the partition ceiling."""
    return min(int(base_minutes) * int(attempt), SHORT_PARTITION_MINUTES)


# Warm-up iterations discarded before the posterior draws (the enlarged panel
# ARG needs a short burn-in, unlike the ingroup-only ARG).
SINGER_BURN_IN = int(os.environ.get("SINGER_BURN_IN", "5"))
#: Genealogies the local-tree rows marginalise each window over. Passed to
#: the rules as a param so a job that does not inherit the environment
#: cannot score at a different size without it showing in the output.
LOCAL_TREE_ENSEMBLE_MEMBERS = int(
    os.environ.get("ANCESTREE_ENSEMBLE_MEMBERS", "128"))
# Highest seed a chunk may reach for while searching for SINGER_N_CHAINS
# runnable chains (see _singer_shard_inputs). Some chunks abort on every seed
# below the high thirties, and a ceiling that cannot find SINGER_N_CHAINS
# runnable chains makes _singer_runnable_seeds raise during DAG construction,
# which aborts every figure target.
SINGER_MAX_SEED = int(os.environ.get("SINGER_MAX_SEED", "96"))


def _persisted_arg_seeds(tool, wc, w):
    """MCMC chain seeds whose persisted ARG draws are on disk for one shard,
    in ascending order. Globbed rather than taken as ``range(n_chains)``: a
    chain re-run after a failure carries the seed it was re-run under, and the
    scoring merge (``_robustness_common.arg_shard_seeds``) reads the same set,
    so requesting ``range`` here would ask for a re-inference of chains that
    already exist under another seed.

    A seed counts only when its directory holds ``meta.json``, the marker the
    writer emits after the last draw, which is the same test arg_shard_seeds
    applies. A chain killed at the tail has draws present but no marker."""
    prefix = (f"{DATA}/robustness_arg_{tool}_{wc.scenario}_{wc.method}"
              f"_n{wc.n_out}_chunk{wc.chunk_idx}_w{w}_s")
    seeds = []
    for path in glob.glob(prefix + "*"):
        tail = path[len(prefix):]
        if tail.isdigit() and os.path.exists(os.path.join(path, "meta.json")):
            seeds.append(int(tail))
    return sorted(seeds)


@functools.cache
def _singer_seeds_module():
    """The shared seed chooser, imported lazily so DAG construction stays cheap."""
    import importlib.util
    spec = importlib.util.spec_from_file_location(
        "_singer_seeds", Path(workflow.basedir) / "scripts" / "_singer_seeds.py")
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def _singer_runnable_seeds(scenario, method, n_out, chunk_idx, n_seeds):
    """The seeds SINGER can actually run for one chunk.

    Delegates to ``workflow/scripts/_singer_seeds.py``, which the scoring merge
    also uses: the DAG and the merge must choose identically, or the merge asks
    for chains the DAG never built.
    """
    return _singer_seeds_module().runnable_seeds(
        scenario, method, n_out, chunk_idx, n_seeds)


def _singer_shard_inputs(wc):
    """Shards for one SINGER chunk-merge job, ``SINGER_N_CHAINS`` of them, on
    the seeds SINGER can run, so the scoring merge still gets the full chain
    count it refuses to go without."""
    shards = []
    for w in range(1):
        for s in _singer_runnable_seeds(wc.scenario, wc.method, wc.n_out,
                                        wc.chunk_idx, SINGER_N_CHAINS):
            shards.append(
                f"{DATA}/robustness_singer_shard_{wc.scenario}_{wc.method}"
                f"_n{wc.n_out}_chunk{wc.chunk_idx}_w{w}_s{s}.json")
    return shards


# ---- Relate baseline rows (sharded: same budget window, single Relate run) --
# Relate infers one genealogy per panel (deterministic given a seed), so there
# is no MCMC average: one "chain" per chunk, on SINGER's budget-subsample
# window. Both methods feed the outgroups into Relate's sample panel, and the
# _ft variant additionally orients Relate with the fixed-tree MAP estimate.
# Kept out of ROBUSTNESS_ALL_METHODS so the general wildcards do not match
# them. Relate provides native arm64 binaries, so these cells run on Apple Silicon.
RELATE_METHODS = ["relate_arg_panel", "relate_arg_panel_ft"]
RELATE_SCENARIOS = CHUNKED_MSP_SCENARIOS + ["slim"]
RELATE_DIR = os.environ.get("RELATE_DIR", str(Path.home() / "opt" / "relate"))


rule install_singer:
    """Build SINGER and install its binaries under ``SINGER_DIR``.

    The benchmark's SINGER rows depend on the binary, which lives outside the
    repo. Declared as an output so a fresh checkout builds it.
    """
    output:
        binary = f"{SINGER_DIR}/singer",
        master = f"{SINGER_DIR}/singer_master",
        convert = f"{SINGER_DIR}/convert_to_tskit",
    params:
        install_dir = SINGER_DIR,
    conda:
        "envs/singer.yml"
    shell:
        "bash workflow/scripts/install_singer.sh {params.install_dir}"


rule install_relate:
    """Build Relate and install its binaries under ``RELATE_DIR``."""
    output:
        binary = f"{RELATE_DIR}/bin/Relate",
    params:
        install_dir = RELATE_DIR,
    conda:
        "envs/bench.yml"
    shell:
        "bash workflow/scripts/install_relate.sh {params.install_dir}"
RELATE_N_CHAINS = int(os.environ.get("RELATE_N_CHAINS", "1"))


def _relate_shard_inputs(wc):
    """Shards for one Relate chunk-merge job, restricted to the (window, seed)
    combinations whose persisted ARG dir exists (mirrors _singer_shard_inputs;
    Relate is reliable so this is normally the full single-run set, but the
    filter keeps a rare missing ARG from blocking the cell)."""
    avail = []
    for w in range(1):
        for s in _persisted_arg_seeds("relate", wc, w):
            shard = (f"{DATA}/robustness_relate_shard_{wc.scenario}_{wc.method}"
                     f"_n{wc.n_out}_chunk{wc.chunk_idx}_w{w}_s{s}.json")
            avail.append(shard)
    return avail or expand(
        f"{DATA}/robustness_relate_shard_{wc.scenario}_{wc.method}"
        f"_n{wc.n_out}_chunk{wc.chunk_idx}_w{{w}}_s{{s}}.json",
        w=range(1), s=range(RELATE_N_CHAINS),
    )


