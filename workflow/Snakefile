# The 4 msprime robustness scenarios are simulated as N independent chunks
# (1/N the length each, distinct seeds) so per-chunk inference runs as small
# parallel jobs and the cell job is a cheap concat, the same idea as the SLiM
# column. Logical scenario key → physical file stem (the baseline cell
# "baseline" is simulated with the 10-outgroup OUTGROUP_EFFECT10 config
# under the stem "baseline10").
ROBUSTNESS_MSP_N_CHUNKS = 10
ROBUSTNESS_MSP_CHUNKS = list(range(ROBUSTNESS_MSP_N_CHUNKS))
CHUNKED_MSP_SCENARIOS = ["baseline", "cpg_hypermut", "strong_ils",
                         "outgroup_clade", "pop_constant", "pop_growth",
                         "pop_decline"]
