"""Snakefile orchestrating Ancestree's benchmark suite.

Lives at ``workflow/Snakefile`` following Snakemake's standard project
layout. The companion ``workflow/scripts/`` directory holds one Python
script per ``simulate``/``infer``/``report`` step. Each reads its I/O from
the ``snakemake`` object and falls back to module-level defaults, so any
single step can be invoked either via the workflow or as
``python workflow/scripts/<step>.py``.

Per-benchmark structure:

- ``simulate_<name>`` writes one ``.trees`` (and any auxiliary inputs the
  baselines need: VCF for PolarBEAR, VCF + FASTA + meta for fastDFE).
- ``infer_<name>_<tool>`` consumes the simulation and runs one tool. Each
  per-tool run is its own rule so snakemake caches the expensive
  subprocess calls independently. Wildcards expand parameter grids, such
  as ``{threshold}`` for the polytomy benchmark and ``{prior}`` for the
  est-sfs comparison.
- ``report_<name>`` aggregates the inference outputs against msprime
  ground truth and writes the ``{json,md}`` pair under
  ``results/reports/``.

Usage (from the project root, with per-rule conda envs)::

    snakemake -j 1 --use-conda           # build every report (rule all)
    snakemake -j 1 report_polytomy       # build one report
    snakemake -j 1 --forceall            # ignore output timestamps, rerun all
    snakemake --dag | dot -Tsvg > dag.svg

The PolarBEAR and fastDFE baseline rules run under their own conda envs
(``envs/polarbear.yml``, ``envs/fastdfe.yml``).
"""

import functools
import glob

import numpy as np
import os
from pathlib import Path

RESULTS = "results"
DATA = f"{RESULTS}/data"

#: Threads for a chunk job. The local-tree kernels are numba prange loops over
#: pairs and windows and scale near-linearly to 8 (measured 7.62x, 95%
#: efficient, whereas 16 gives 10.07x, 63%), so 8 is the throughput-optimal
#: ask on a shared cluster.
LOCAL_TREE_THREADS = 8
REPORTS = f"{RESULTS}/reports"
SCRIPTS = "workflow/scripts"
LATEX = "reports/manuscripts/latex"
#: The manuscript as it stood before the focal node and ensemble sampling
#: entered it. Frozen, so the revision diff always measures against the same
#: reference rather than against HEAD~.
LATEX_BASE = "reports/manuscripts/latex_baseline"
LATEX_DIFF = "reports/manuscripts/latex_diff"

#: Every figure \includegraphics'd by the manuscript, by basename. Named rather
#: than collected from the rules, because a figure is in the paper if the LaTeX
#: includes it, not if some rule happens to build it.
