        chunk_idx = r"[0-9]+",
    conda:
        "envs/tsinfer.yml"
    script:
        "scripts/build_tsinfer_arg.py"


rule infer_slim_outgroup_bias_tsinfer_arg:
    """ARG-mode inference on a tsinfer-inferred ingroup-only ARG.

    Truth ancestral states are read from the simulator-truth ts keyed by
    site position. Only sites tsinfer kept and that have a known truth
    are scored. Single output file per ``(chunk_idx, f_del)``, with no n_out
    wildcard because tsinfer-ARG inference does not consume outgroups.
    """
    input:
        inferred = rules.build_tsinfer_arg.output[0],
        truth_trees = rules.recap_and_mutate_slim_outgroup_bias.output.trees,
        meta = rules.recap_and_mutate_slim_outgroup_bias.output.meta,
    output:
        f"{DATA}/slim_outgroup_bias_fdel{{f_del}}_chunk{{chunk_idx}}_tsinfer_arg.json",
    params:
        mu_slim = SLIM_OUTGROUP_BIAS_MU_SLIM,
    wildcard_constraints:
        f_del = r"[0-9.]+",
        chunk_idx = r"[0-9]+",
    conda:
        "envs/tsinfer.yml"
    script:
        "scripts/infer_slim_outgroup_bias_tsinfer_arg.py"


rule report_slim_outgroup_bias:
    """Aggregate the (chunk × f_del × n_out) grid for all three
    modes (vcf / arg_true / arg_tsinfer) → slim_outgroup_bias.{json,md}.

    Per-bin uSFS counts and simulator-truth histograms are summed across
    chunks for each (f_del, n_out, mode) cell before computing the L1 bias.
    """
    input:
        cells = expand(
            f"{DATA}/slim_outgroup_bias_fdel{{f_del}}_chunk{{chunk_idx}}_n{{n_out}}.json",
            f_del=SLIM_OUTGROUP_BIAS_F_DELS,
            chunk_idx=SLIM_OUTGROUP_BIAS_CHUNK_IDXS,
            n_out=SLIM_OUTGROUP_BIAS_N_OUTS,
        ),
        cells_arg = expand(
            f"{DATA}/slim_outgroup_bias_fdel{{f_del}}_chunk{{chunk_idx}}_arg_n{{n_out}}.json",
            f_del=SLIM_OUTGROUP_BIAS_F_DELS,
            chunk_idx=SLIM_OUTGROUP_BIAS_CHUNK_IDXS,
            n_out=SLIM_OUTGROUP_BIAS_N_OUTS,
        ),
        cells_tsinfer = expand(
            f"{DATA}/slim_outgroup_bias_fdel{{f_del}}_chunk{{chunk_idx}}_tsinfer_arg.json",
            f_del=SLIM_OUTGROUP_BIAS_F_DELS,
            chunk_idx=SLIM_OUTGROUP_BIAS_CHUNK_IDXS,
        ),
    output:
        json = f"{REPORTS}/slim_outgroup_bias.json",
        md = f"{REPORTS}/slim_outgroup_bias.md",
    params:
        f_dels = [float(x) for x in SLIM_OUTGROUP_BIAS_F_DELS],
        n_outs = SLIM_OUTGROUP_BIAS_N_OUTS,
        chunk_idxs = SLIM_OUTGROUP_BIAS_CHUNK_IDXS,
        sim_config = {
            **SLIM_OUTGROUP_BIAS_CONFIG,
            "n_chunks": SLIM_OUTGROUP_BIAS_N_CHUNKS,
            "seq_len_per_chunk": SLIM_OUTGROUP_BIAS_SEQ_LEN_PER_CHUNK,
            "time_scaling": SLIM_OUTGROUP_BIAS_TIME_SCALING,
            "mu_slim": SLIM_OUTGROUP_BIAS_MU_SLIM,
            "rho_slim": SLIM_OUTGROUP_BIAS_RHO_SLIM,
            "outgroup_split_times_slim": SLIM_OUTGROUP_BIAS_T_SLIM,
        },
    conda:
        "envs/bench.yml"
    script:
        "scripts/report_slim_outgroup_bias.py"


