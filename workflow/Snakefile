# ----------------------------- reproducibility re-runs of reference tools

#: Upstream PolarBEAR, pinned. The repo is the one named in the paper's data
#: availability statement. external/ is gitignored, so the fetch rule is what
#: lets a fresh checkout rebuild the baseline.
POLARBEAR_REPO = "https://gitlab.gwdg.de/molsysevol/polarizing_without_outgroup"
POLARBEAR_COMMIT = "078871d7690210caf1ca3a4481352cc1113ba670"


rule fetch_polarbear:
    """Clone PolarBEAR at a pinned commit and apply the posterior patch.

    Upstream writes only the MAP state and its probability. The patch adds the
    full normalised posterior over A/C/G/T, which the MSL agreement matrix
    needs to compare PolarBEAR on anything but MAP estimates."""
    output:
        marker = "external/polarbear/.ancestree_patched",
        script = "external/polarbear/code/polarize/site_polarize.py",
    input:
        patch = "workflow/patches/polarbear-full-posteriors.patch",
    params:
        repo = POLARBEAR_REPO,
        commit = POLARBEAR_COMMIT,
        root = "external/polarbear",
    conda:
        "envs/base.yml"
    shell:
        r"""
        set -euo pipefail
        # Clone aside and sync the code in, rather than rm -rf'ing the root:
        # data/real_data is a multi-GB download that does NOT live in the repo
        # (see fetch_polarbear_realdata), and wiping it on every re-clone would
        # throw it away.
        tmp=$(mktemp -d)
        trap 'rm -rf "$tmp"' EXIT
        git clone -q {params.repo} "$tmp/pb"
        git -C "$tmp/pb" checkout -q {params.commit}
        git -C "$tmp/pb" apply --verbose $(realpath {input.patch})
        mkdir -p {params.root}
        rm -rf {params.root}/code
        cp -a "$tmp/pb/code" {params.root}/code
        cp -a "$tmp/pb/LICENSE" "$tmp/pb/README.md" {params.root}/ 2>/dev/null || true
        echo "{params.commit}" > {output.marker}
        """


rule rerun_polarbear_msl_chr1:
    """Re-run PolarBEAR's ancestral-state step on the archived gamma-SMC
    tskit ARG (skipping the multi-day gamma-SMC re-inference) and record
    wall-clock time. The output is byte-comparable to the archived
    anc_state.txt."""
    input:
        trees = MSL_REAL_DATA_FILES["gammaSMC_trees"],
        vcf = MSL_REAL_DATA_FILES["msl_vcf_population"],
        polarbear = rules.fetch_polarbear.output.marker,
    output:
        anc = f"{DATA}/rerun_polarbear_anc_state.txt",
        meta = f"{DATA}/rerun_polarbear_meta.json",
        # Read by report_msl_informative_prior, so declared here rather than
        # left as undeclared work-directory contents with no producer.
        prob_full = f"{DATA}/rerun_polarbear_workdir/prob_ancstate_full.txt",
    params:
        polarbear_root = "external/polarbear",
        theta = MSL_THETA,
        work_dir = f"{DATA}/rerun_polarbear_workdir",
    resources:
        runtime = lambda wildcards, attempt: capped_runtime(720, attempt),
