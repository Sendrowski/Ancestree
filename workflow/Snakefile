# ----------------------------- real-data MSL chr1 benchmark
# Against the published PolarBEAR and est-sfs outputs. Standalone target, not
# in ``rule all``. Build via ``snakemake -j 8 report_msl_3way_chr1``. The
# PolarBEAR Edmond archive (https://edmond.mpg.de/file.xhtml?fileId=330797)
# is fetched and extracted under external/polarbear/data/real_data/ by
# rule download_msl_realdata.

MSL_REAL_DATA_ROOT = "external/polarbear/data/real_data"
MSL_REAL_DATA_FILES = dict(
    # Subset of prepare_msl_realdata's EXPECTED dict needed as snakemake
    # rule inputs. The prepare rule still verifies the full set.
    msl_vcf_population = (
        f"{MSL_REAL_DATA_ROOT}/ancestral_state/PolarBEAR_gammaSMC/"
        f"chr1.snp_only.collapsed.bed_filtered.MSL.cleaned.vcf.gz"
    ),
    msl_simplify_vcf = (
        f"{MSL_REAL_DATA_ROOT}/ancestral_state/est_sfs/"
        f"chr1.snp_only.collapsed.bed_filtered.MSL.cleaned.ponAbe2_macFas5.simplify.vcf.gz"
    ),
    gammaSMC_trees = (
        f"{MSL_REAL_DATA_ROOT}/ancestral_state/PolarBEAR_gammaSMC/"
        f"chr1.snp_only.collapsed.bed_filtered.MSL.cleaned_tskit.trees"
    ),
    polarbear_anc_state = (
        f"{MSL_REAL_DATA_ROOT}/ancestral_state/PolarBEAR_gammaSMC/anc_state.txt"
    ),
    estsfs_anc_state = (
        f"{MSL_REAL_DATA_ROOT}/ancestral_state/est_sfs/est-sfs_ancstate.txt"
    ),
    msl_panel = f"{MSL_REAL_DATA_ROOT}/ancestral_state/MSL.panel",
    # An input of report_msl_agreement_matrix, so it must be declared here or
    # that rule has no producer on a fresh checkout.
    polarbear_prob_ancstate = (
        f"{MSL_REAL_DATA_ROOT}/ancestral_state/PolarBEAR_gammaSMC/"
        f"prob_ancstate.txt"
    ),
    snpeff_dir = f"{MSL_REAL_DATA_ROOT}/SnpEff_annotation",
)
# Human per-site per-generation mutation rate. Same scale as PolarBEAR
# tutorial / real-data PSMC config.
MSL_MU = 1.25e-8
# The archived gamma-SMC ARG stores node times in coalescent units, not
# generations (``time_units`` is "unknown" and the deepest node sits at 6.5).
# One unit is 4*Ne generations, so the expected substitutions on a branch are
# MSL_THETA times its stored length. This is the branch time_scale for that
# ARG and the theta PolarBEAR is given for the same file.
MSL_NE = 1e4
MSL_THETA = 4 * MSL_NE * MSL_MU
MSL_OUTGROUPS = ["ponAbe2", "macFas5"]


rule download_msl_realdata:
    """Download and extract the PolarBEAR Edmond/MPG real-data archive
    (≈12 GB zip → ≈25 GB extracted). Idempotent: the sentinel file skips
    the rule, ``curl -C -`` resumes a partial download and ``unzip -o`` is
    safe to re-run. The zip is kept on disk after extraction. To force a
    fresh download, delete the sentinel
    ``external/polarbear/data/real_data/.extracted_v1``.
    """
    output:
        # ``protected()`` chmods outputs read-only after creation so an
        # accidental ``rm`` cannot remove the 12 GB zip or the extraction
        # sentinel. To force a fresh download:
        #   chmod u+w external/polarbear/data/real_data/{real_data.zip,.extracted_v1}
        #   rm external/polarbear/data/real_data/.extracted_v1
        sentinel = protected(f"{MSL_REAL_DATA_ROOT}/.extracted_v1"),
        # The archive members the workflow consumes, declared so the DAG can
        # produce them and so a truncated extraction fails here rather than
        # leaving a plausible-looking tree for a later rule to trip over.
        **{k: protected(v) for k, v in MSL_REAL_DATA_FILES.items()
           if k != "snpeff_dir"},
        # A file inside the tree rather than directory(): a directory output
        # counts as produced the moment it exists, however little is in it.
        snpeff_ok = protected(f'{MSL_REAL_DATA_FILES["snpeff_dir"]}/.extracted'),
    params:
        url = "https://edmond.mpg.de/api/access/datafile/330797",
        root = MSL_REAL_DATA_ROOT,
        # Not a declared output: snakemake deletes a failed job's outputs, and
        # as a params path the zip survives a failed extraction so that
        # ``curl -C -`` resumes it.
        zip = f"{MSL_REAL_DATA_ROOT}/real_data.zip",
        snpeff_dir = MSL_REAL_DATA_FILES["snpeff_dir"],
    conda:
        "envs/bench.yml"
    shell:
        r"""
        set -euo pipefail
        mkdir -p {params.root}
        # Completeness is tested rather than inferred from the file existing,
        # so a truncated zip resumes instead of being extracted as-is. curl
        # -C - on an already-complete file asks for a range past EOF and the
        # server answers 416, so its status is tolerated and the archive test
        # below is what decides.
        if [ ! -f "{params.zip}" ] || ! unzip -tqq "{params.zip}" >/dev/null 2>&1; then
            echo "[download_msl_realdata] downloading/resuming {params.zip} (≈12 GB)..."
            curl -L --retry 3 --retry-delay 5 -C - -o "{params.zip}" '{params.url}' || true
            unzip -tqq "{params.zip}" >/dev/null
        else
            echo "[download_msl_realdata] zip already present and intact"
        fi
        echo "[download_msl_realdata] extracting into {params.root}/ ..."
        # unzip exits 1 for warnings, which covers both a harmless caveat and
        # "some members could not be extracted". Accept it only when the
        # archive itself still tests clean, so a partial extraction cannot be
        # recorded as complete and then frozen by protected().
        set +e
        unzip -q -o "{params.zip}" -d "{params.root}/"
        rc=$?
        set -e
        if [ "$rc" -gt 1 ]; then exit "$rc"; fi
        if [ "$rc" -eq 1 ]; then unzip -tqq "{params.zip}" >/dev/null; fi
        test -d "{params.snpeff_dir}"
        touch "{params.snpeff_dir}/.extracted"
        touch "{output.sentinel}"
        echo "[download_msl_realdata] complete"
        """


rule prepare_msl_realdata:
    """Verify the PolarBEAR real-data archive layout and emit a manifest.

    Depends on :rule:`download_msl_realdata` to fetch and extract the
    archive. That rule is itself idempotent and skips when its sentinel
    is already present.
    """
    input:
        sentinel = rules.download_msl_realdata.output.sentinel,
        real_data_root = MSL_REAL_DATA_ROOT,
    output:
        manifest = f"{DATA}/msl_manifest.json",
    conda:
        "envs/bench.yml"
    script:
        "scripts/prepare_msl_realdata.py"


# ----------------------------- chunked MSL chr1 pipeline (region + subsample wildcards)
# A cached extraction stage, a subsample-driven fit+infer stage and a 3-way
# comparison stage, so regions, subsample sizes and RNG seeds run in parallel.
# Wildcards: {region} (chr<N>_<start>_<end>[KMG], parsed in
# extract_msl_polymorphic.py), {n_subsample} (full / 25k / 100k / 1M, passed
# verbatim to the fit script), {seed} (RNG seed of the random subsample) and
# {infer_scope} (``subsample``: posteriors for the fitted subsample only, or
# ``all``: posteriors for every polymorphic site after the fit, slower).

rule extract_msl_polymorphic:
    """Per-chunk filter: reads a single chunked .vcf.gz produced by
    ``split_msl_pseudo_vcf``, applies the ingroup-polymorphic filter and
    writes a compact .npz. Each chunk reads its own file, so this step
    parallelises across chunks."""
    input:
        simplify_vcf = f"{DATA}/msl_pseudo_vcf_{{region}}.vcf.gz",
        panel = MSL_REAL_DATA_FILES["msl_panel"],
    output:
        npz = f"{DATA}/msl_polymorphic_{{region}}.npz",
        meta = f"{DATA}/msl_polymorphic_{{region}}_meta.json",
    params:
        outgroup_samples = MSL_OUTGROUPS,
    conda:
        "envs/bench.yml"
    script:
        "scripts/extract_msl_polymorphic.py"


rule fit_infer_msl_vcf:
    """FixedTreeInference on a subsample of the cached .npz, emitting
    per-site MAP estimates in the PolarBEAR-comparable schema."""
    input:
        npz = f"{DATA}/msl_polymorphic_{{region}}.npz",
        meta = f"{DATA}/msl_polymorphic_{{region}}_meta.json",
    output:
        anc = f"{DATA}/msl_vcf_{{region}}_n{{n_subsample}}_seed{{seed}}_{{infer_scope}}.txt",
        meta = f"{DATA}/msl_vcf_{{region}}_n{{n_subsample}}_seed{{seed}}_{{infer_scope}}_meta.json",
        posteriors = f"{DATA}/msl_vcf_{{region}}_n{{n_subsample}}_seed{{seed}}_{{infer_scope}}_posteriors.npz",
    wildcard_constraints:
        # ``chr1full`` is reserved for the aggregate target. This rule
        # only handles per-chunk regions.
        region = "(?!chr1full$).+",
    conda:
        "envs/bench.yml"
    script:
        "scripts/fit_infer_msl_vcf.py"


rule report_msl_3way:
    """3-way agreement Ancestree-VCF ↔ PolarBEAR ↔ est-sfs for a given
    (region, n_subsample, seed, infer_scope) configuration."""
    input:
        vcf_anc = rules.fit_infer_msl_vcf.output.anc,
        vcf_meta = rules.fit_infer_msl_vcf.output.meta,
        polarbear_anc = MSL_REAL_DATA_FILES["polarbear_anc_state"],
        estsfs_anc = MSL_REAL_DATA_FILES["estsfs_anc_state"],
        msl_population_vcf = MSL_REAL_DATA_FILES["msl_vcf_population"],
        snpeff_ok = rules.download_msl_realdata.output.snpeff_ok,
    output:
        json = f"{REPORTS}/msl_3way_{{region}}_n{{n_subsample}}_seed{{seed}}_{{infer_scope}}.json",
        md = f"{REPORTS}/msl_3way_{{region}}_n{{n_subsample}}_seed{{seed}}_{{infer_scope}}.md",
    conda:
        "envs/bench.yml"
    script:
        "scripts/report_msl_3way.py"


# Chunked-pipeline targets: split chr1 into 25 Mb chunks for parallel
# fit + infer over disjoint position ranges. Each chunk is an independent
# `(region, n_subsample, seed, infer_scope)` cell driven through the
# rules above, and the aggregate rule concatenates per-chunk call files.
MSL_CHR1_LENGTH_BP = 248_956_422  # GRCh38 chr1 length
MSL_CHUNK_SIZE_BP = 6_250_000  # 40 chunks across chr1 (≈25 K sites each)
MSL_CHR1_CHUNKS = [
    (chunk_start, min(chunk_start + MSL_CHUNK_SIZE_BP, MSL_CHR1_LENGTH_BP))
    for chunk_start in range(0, MSL_CHR1_LENGTH_BP, MSL_CHUNK_SIZE_BP)
]


def _chunk_region(start_bp: int, end_bp: int) -> str:
    """Format chunk bounds as a region wildcard like ``chr1_0M_25M``."""
    def _fmt(bp: int) -> str:
        if bp == 0:
            return "0"
        if bp % 1_000_000 == 0:
            return f"{bp // 1_000_000}M"
        return str(bp)
    return f"chr1_{_fmt(start_bp)}_{_fmt(end_bp)}"


MSL_CHR1_CHUNK_REGIONS = [_chunk_region(s, e) for s, e in MSL_CHR1_CHUNKS]


rule split_msl_pseudo_vcf:
    """Split the pseudo-VCF into N positional chunks (one .vcf.gz per
    chunk). No filtering at this stage: chunks contain every line in their
    range, including ingroup-monomorphic ones. Filtering happens in
    ``extract_msl_polymorphic`` per chunk."""
    input:
        simplify_vcf = MSL_REAL_DATA_FILES["msl_simplify_vcf"],
    output:
        chunks = expand(
            f"{DATA}/msl_pseudo_vcf_{{region}}.vcf.gz",
            region=MSL_CHR1_CHUNK_REGIONS,
        ),
        manifest = f"{DATA}/msl_pseudo_vcf_chunks_manifest.json",
    params:
        chunks = [
            (region, start, end)
            for region, (start, end) in zip(MSL_CHR1_CHUNK_REGIONS, MSL_CHR1_CHUNKS)
        ],
    conda:
        "envs/bench.yml"
    script:
        "scripts/split_msl_pseudo_vcf.py"


# Prefer aggregate over fit_infer for the chr1full target.
ruleorder: aggregate_msl_vcf_chr1 > fit_infer_msl_vcf
ruleorder: report_msl_3way_chr1 > report_msl_3way


rule aggregate_msl_vcf_chr1:
    """Concatenate per-chunk Ancestree-VCF call files (and per-chunk
    posteriors) into a single chr1-wide call set, posterior file, and
    meta manifest. Runs the chunks in parallel by declaring all per-chunk
    outputs as inputs.

    Build via:
        snakemake -j N aggregate_msl_vcf_chr1_n100k_seed0_all
    where N is the number of chunks to run in parallel.
    """
    input:
        chunks = lambda wc: expand(
            f"{DATA}/msl_vcf_{{region}}_n{{n_subsample}}_seed{{seed}}_{{infer_scope}}.txt",
            region=MSL_CHR1_CHUNK_REGIONS,
            n_subsample=[wc.n_subsample],
            seed=[wc.seed],
            infer_scope=[wc.infer_scope],
        ),
        chunk_metas = lambda wc: expand(
            f"{DATA}/msl_vcf_{{region}}_n{{n_subsample}}_seed{{seed}}_{{infer_scope}}_meta.json",
            region=MSL_CHR1_CHUNK_REGIONS,
            n_subsample=[wc.n_subsample],
            seed=[wc.seed],
            infer_scope=[wc.infer_scope],
        ),
        chunk_posteriors = lambda wc: expand(
            f"{DATA}/msl_vcf_{{region}}_n{{n_subsample}}_seed{{seed}}_{{infer_scope}}_posteriors.npz",
            region=MSL_CHR1_CHUNK_REGIONS,
            n_subsample=[wc.n_subsample],
            seed=[wc.seed],
            infer_scope=[wc.infer_scope],
        ),
    output:
        anc = f"{DATA}/msl_vcf_chr1full_n{{n_subsample}}_seed{{seed}}_{{infer_scope}}.txt",
        meta = f"{DATA}/msl_vcf_chr1full_n{{n_subsample}}_seed{{seed}}_{{infer_scope}}_meta.json",
        posteriors = f"{DATA}/msl_vcf_chr1full_n{{n_subsample}}_seed{{seed}}_{{infer_scope}}_posteriors.npz",
    run:
        import json
        from pathlib import Path
        import numpy as np
        # Concatenate per-chunk per-site call files (pos\tallele_idx).
        with open(output.anc, "w") as fout:
            for cf in input.chunks:
                with open(cf) as fin:
                    for line in fin:
                        fout.write(line)
        # Concatenate per-chunk posteriors into one .npz along axis 0.
        # Empty chunks (e.g. the chr1 centromere span) save posterior as a
        # 1-D zero-length array, so skip those when concatenating.
        all_pos = []
        all_post = []
        alleles_arr = None
        for p in input.chunk_posteriors:
            d = np.load(p, allow_pickle=True)
            pos = d["pos"]
            post = d["posterior"]
            if pos.shape[0] == 0:
                continue
            if post.ndim == 1:
                post = post.reshape(-1, 4)
            all_pos.append(pos)
            all_post.append(post)
            if alleles_arr is None:
                alleles_arr = d["alleles"]
        np.savez_compressed(
            output.posteriors,
            pos=np.concatenate(all_pos),
            posterior=np.concatenate(all_post),
            alleles=alleles_arr,
        )
        # Aggregate meta: keep per-chunk paths + counts.
        metas = [json.load(open(p)) for p in input.chunk_metas]
        n_per_chunk = [m.get('n_sites_in_infer', m.get('n_sites_in_fit', 0)) for m in metas]
        out_meta = {
            'aggregated_from': list(input.chunks),
            'n_sites_total': sum(n_per_chunk),
            'n_sites_per_chunk': dict(zip([m.get('region') for m in metas], n_per_chunk)),
            'timings_per_chunk_seconds': {
                m.get('region'): m.get('timings_seconds', {}).get('total') for m in metas
            },
            'chunks_meta_paths': list(input.chunk_metas),
        }
        with open(output.meta, "w") as f:
            json.dump(out_meta, f, indent=2)


rule stream_infer_msl_arg_all:
    """ARG-mode streaming inference: load the gamma-SMC ARG once, then
    iterate all 40 per-chunk ingroup .npz files in position order, building
    Sites from haplotype states and running the Felsenstein kernel against
    the live local tree.

    Streaming pays the ARG load cost once. Projecting the ARG per chunk with
    ``ts.keep_intervals(simplify=True)`` takes over 30 min per chunk on this
    2.26M-tree ARG.

    Wildcard-free: this rule produces all 40 chunks in one process, since
    two processes would each need the whole ARG in memory."""
    input:
        trees = MSL_REAL_DATA_FILES["gammaSMC_trees"],
        npz_files = expand(
            f"{DATA}/msl_polymorphic_{{region}}.npz",
            region=MSL_CHR1_CHUNK_REGIONS,
        ),
    output:
        calls = expand(
            f"{DATA}/msl_arg_{{region}}_calls.txt",
            region=MSL_CHR1_CHUNK_REGIONS,
        ),
        metas = expand(
            f"{DATA}/msl_arg_{{region}}_calls_meta.json",
            region=MSL_CHR1_CHUNK_REGIONS,
        ),
        posteriors = expand(
            f"{DATA}/msl_arg_{{region}}_posteriors.npz",
            region=MSL_CHR1_CHUNK_REGIONS,
        ),
        overall_meta = f"{DATA}/msl_arg_chr1full_streaming_meta.json",
    params:
        time_scale = MSL_THETA,
    resources:
        # Streams chr1's ARG chunks at n=174. The 8 GB profile default is not
        # enough to hold even one chunk's trees and OOM-kills on load.
        mem_mb = lambda wildcards, attempt: 96000 * attempt,
        runtime = lambda wildcards, attempt: capped_runtime(720, attempt),
    conda:
        "envs/bench.yml"
    script:
        "scripts/stream_infer_msl_arg.py"


rule aggregate_msl_arg_chr1:
    """ARG-mode aggregate: concatenate per-chunk ARG-mode call files and
    posteriors into a chr1-wide call set, posterior matrix, and meta
    manifest."""
    input:
        chunks = expand(
            f"{DATA}/msl_arg_{{region}}_calls.txt",
            region=MSL_CHR1_CHUNK_REGIONS,
        ),
        chunk_metas = expand(
            f"{DATA}/msl_arg_{{region}}_calls_meta.json",
            region=MSL_CHR1_CHUNK_REGIONS,
        ),
        chunk_posteriors = expand(
            f"{DATA}/msl_arg_{{region}}_posteriors.npz",
            region=MSL_CHR1_CHUNK_REGIONS,
        ),
    output:
        anc = f"{DATA}/msl_arg_chr1full_calls.txt",
        meta = f"{DATA}/msl_arg_chr1full_calls_meta.json",
        posteriors = f"{DATA}/msl_arg_chr1full_posteriors.npz",
    run:
        import json
        import numpy as np
        # Concatenate per-chunk per-site call files.
        with open(output.anc, "w") as fout:
            for cf in input.chunks:
                with open(cf) as fin:
                    for line in fin:
                        fout.write(line)
        # Concatenate posteriors (skip empty / 1-D zero-length chunks).
        all_pos, all_post = [], []
        alleles_arr = None
        for p in input.chunk_posteriors:
            d = np.load(p, allow_pickle=True)
            pos = d["pos"]
            post = d["posterior"]
            if pos.shape[0] == 0:
                continue
            if post.ndim == 1:
                post = post.reshape(-1, 4)
            all_pos.append(pos)
            all_post.append(post)
            if alleles_arr is None:
                alleles_arr = d["alleles"]
        np.savez_compressed(
            output.posteriors,
            pos=np.concatenate(all_pos) if all_pos else np.zeros(0, dtype=np.int32),
            posterior=np.concatenate(all_post) if all_post else np.zeros((0, 4), dtype=np.float32),
            alleles=alleles_arr,
        )
        metas = [json.load(open(p)) for p in input.chunk_metas]
        out_meta = {
            "aggregated_from": list(input.chunks),
            "n_sites_total": sum(m.get("n_sites_written", 0) for m in metas),
            "n_sites_per_chunk": {m.get("region"): m.get("n_sites_written", 0) for m in metas},
            "timings_per_chunk_seconds": {
                m.get("region"): m.get("timings_seconds", {}).get("total") for m in metas
            },
        }
        with open(output.meta, "w") as f:
            json.dump(out_meta, f, indent=2)


