# Fixed-tree mirror of infer_baseline across the same n_out range
# (n=0 degenerates to "Kingman prior only", no outgroup-ladder fit).
OUTGROUP_EFFECT_N_OUTS_VCF = OUTGROUP_EFFECT_N_OUTS

rule infer_baseline_vcf:
    """VCF-mode (FixedTreeInference) over the same sim, paired site-for-site
    with infer_baseline's ARG cells. Demonstrates the ARG-vs-fixed-tree
    trade-off as outgroups disappear.
    """
    input:
        trees = rules.simulate_baseline.output.trees,
        meta = rules.simulate_baseline.output.meta,
    output:
        f"{DATA}/baseline_vcf_n{{n_out}}.json",
    params:
        mu = OUTGROUP_EFFECT_CONFIG["mu"],
    conda:
        "envs/bench.yml"
    script:
        "scripts/infer_baseline_vcf.py"


rule report_baseline:
    """Aggregate per-n_out cells (ARG + VCF mirror) → baseline.{json,md}."""
    input:
        cells = expand(
            f"{DATA}/baseline_n{{n_out}}.json",
            n_out=OUTGROUP_EFFECT_N_OUTS,
        ),
        cells_vcf = expand(
            f"{DATA}/baseline_vcf_n{{n_out}}.json",
            n_out=OUTGROUP_EFFECT_N_OUTS_VCF,
        ),
        resimulated = rules.infer_baseline_resimulated.output[0],
    output:
        json = f"{REPORTS}/baseline.json",
        md = f"{REPORTS}/baseline.md",
    params:
        sim_config = {**OUTGROUP_EFFECT_CONFIG, "n_outs": OUTGROUP_EFFECT_N_OUTS},
    conda:
        "envs/bench.yml"
    script:
        "scripts/report_baseline.py"


