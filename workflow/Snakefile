INGROUP_SIZE_SEEDS = [100, 101, 102]




# Outgroup-divergence grid: the same n_out=3 demography as the
# outgroup-effect benchmark, varying the placement of the three outgroup
# splits over a 2-D grid: (deepest-split depth) × (relative spacing of the
# closer two). Each (depth, spacing) sim is run through the ARG, fixed-tree
# (VCF) and local-tree inference modes. Standalone benchmark, not in
# ``rule all``. Build via ``snakemake -j 1 report_outgroup_divergence``.
# The spacing-strategy → split-times mapping lives in
# workflow/scripts/_outgroup_divergence_common.py.
OUTGROUP_DIVERGENCE_CONFIG = dict(
    n_ingroup=20, length=1e6, mu=1.25e-8, rec_rate=1e-8,
    pop_size=3e4, ingroup_pop_size=3e4, seed=42,
)
# Uniform in log space (a factor of 3 per step), reaching shallow enough
# that the outgroups stop being informative and ARG mode degrades.
OUTGROUP_DIVERGENCE_DEPTHS = [
    "1e4", "1.6e4", "2.5e4", "4e4",
    "6.3e4", "1e5", "1.6e5", "2.5e5",
    "4e5", "6.3e5", "1e6", "1.6e6",
    "2.5e6", "4e6", "6.3e6", "1e7",
]
OUTGROUP_DIVERGENCE_SPACINGS = ["linear", "geometric", "compact_near", "compact_far"]
# Outgroup counts each simulated cell is subsetted to, without re-simulating:
# 3 keeps all three populations, 2 the shallowest and the deepest, 1 the middle.
OUTGROUP_DIVERGENCE_N_OUTS = [1, 2, 3]


# Substitution-model comparison: per-bin SFS-accuracy penalty from
# substitution-model misspecification when the data is generated under
# HKY (κ ≠ 1, non-uniform π). The outgroup-effect demography (ingroup + 3
# outgroups at 3e5/9e5/1.5e6 gens), but the mutator is
# ``msprime.HKY(kappa=4, pi=AT-rich)`` so JC69 / K2 / F81 each miss at
# least one axis the simulator cares about. Runs both ARG and fixed-tree
# (VCF) inference modes per Ancestree model. Standalone target, not in
# ``rule all``. Build via ``snakemake -j 1 report_model_comparison``.
MODEL_COMPARISON_CONFIG = dict(
    n_ingroup=20, n_outgroup_pops=3,
    length=1e7, mu=1.25e-8, rec_rate=1e-8,
    pop_size=3e4, ingroup_pop_size=3e4,
    outgroup_split_times=[3e5, 9e5, 1.5e6],
    kappa=4.0,
    equilibrium_frequencies=[0.30, 0.20, 0.20, 0.30],  # AT-rich (A,C,G,T)
    seed=42,
)
MODEL_COMPARISON_MODELS = ["jc69", "k2", "f81", "hky", "gtr"]
MODEL_COMPARISON_MODES = ["arg", "vcf"]
# Monoallelic-ingroup caterpillar benchmark: reuses the outgroup-effect
# demography (ingroup + 3 outgroups at 3e5/9e5/1.5e6 gens) and compares
# OutgroupLadderTree (rooted at ingroup MRCA, wrong on monoallelic-ingroup
# fixed-derived sites) vs the same ladder read at its deepest join (the
# deep outgroup ancestor, recovers the ancestral state via full
# Felsenstein over all outgroups). Standalone target, not in ``rule all``.
# Build via ``snakemake -j 1 report_caterpillar``.
CATERPILLAR_CONFIG = dict(OUTGROUP_EFFECT_CONFIG)
CATERPILLAR_TREE_TYPES = ["ladder", "caterpillar"]




# Missing-data robustness grid: reuses the outgroup-effect demography
# (ingroup of 20 + 3 outgroups). One simulation, many cells: each cell
# randomly nulls out ``missing_frac`` of the outgroup tip slots per site
# (independent Bernoulli) with a per-cell RNG seed, then runs
# FixedTreeInference (HKY + Kingman + full). 3 seeds per fraction for error
# bars. Standalone target, not in ``rule all``. Build via
# ``snakemake -j 1 report_missing_data``.
MISSING_DATA_CONFIG = dict(OUTGROUP_EFFECT_CONFIG)
MISSING_DATA_FRACTIONS = [0.0, 0.05, 0.1, 0.25, 0.5]
MISSING_DATA_SEEDS = [100, 101, 102]


# Site-scaling benchmark: how many polymorphic sites FixedTreeInference
# needs to localise its (K_i, kappa) parameters (the fixed-tree axis) and
# how many to localise the AdaptiveIngroupWeight's pi_i bins (the adaptive
# axis). The inference scripts subsample a simulated ARG's polymorphic-site
# catalog to ``n_sites`` per cell. Standalone targets, not in ``rule all``.
# Build via ``snakemake -j N report_site_scaling``.
SITE_SCALING_CONFIG = dict(
    n_ingroup=20, n_outgroup_pops=3,
    length=1.5e7, mu=1.25e-8, rec_rate=1e-8,
    pop_size=3e4, ingroup_pop_size=3e4,
    outgroup_split_times=[3e5, 9e5, 1.5e6],
    seed=42,
)
SITE_SCALING_FIXED_MODELS = ["JC", "HKY"]
SITE_SCALING_FIXED_N_OUTS = [1, 2, 3]
SITE_SCALING_FIXED_N_SITES = [100, 300, 1000, 3000, 10000, 30000, 100000]
SITE_SCALING_FIXED_SEEDS = [100, 101, 102, 103, 104]
SITE_SCALING_ADAPTIVE_N_SUBS = [5, 10, 15, 20]
SITE_SCALING_ADAPTIVE_N_SITES = [100, 300, 1000, 3000, 10000, 30000, 100000]
# Adaptive cells only consume ingroup-polymorphic sites, and n_sub=5 caps
# the per-sim pool at theta·H_4·L. Use a larger-L sim so all n_sub
# cells reach the 100k grid point.
SITE_SCALING_ADAPTIVE_CONFIG = dict(SITE_SCALING_CONFIG, length=3.5e7)
SITE_SCALING_ADAPTIVE_SEEDS = [100, 101, 102, 103, 104]


# ---------------------------------------------------------------- entry point

rule manuscript:
    """Build the manuscript PDF (tectonic) from its hand-edited LaTeX sources.

    A thin DAG node: it depends on the human-edited sources (``main.tex``,
    the ``sections/`` includes and ``refs.bib``) plus the figures and tables
    the document includes, so it rebuilds the PDF when a figure, a table or
    the text changes. It does not re-run the benchmarks behind them: the
    figure rules depend on the cached per-cell summaries, not on the
    inference.
    """
    input:
        # Built by their own rules, named here so `manuscript` cannot
        # succeed with them stale. Not in MANUSCRIPT_TABLES, which drives
        # benchmark_tables' own outputs.
        "reports/manuscripts/latex/tables/edge_cases_body.tex",
        "reports/manuscripts/latex/tables/kernel_bench_body.tex",
        "reports/manuscripts/latex/tables/msl_informative_prior.tex",
        "reports/manuscripts/latex/tables/msl_runtime.tex",
        f"{LATEX}/main.tex",
        glob.glob(f"{LATEX}/sections/*.tex"),
        f"{LATEX}/refs.bib",
        # The figures and tables it includes, so a regenerated figure
        # rebuilds the PDF.
        expand(f"{LATEX}/figures/{{name}}.pdf", name=MANUSCRIPT_FIGURES),
        expand(f"{LATEX}/tables/{{name}}.tex", name=MANUSCRIPT_TABLES),
    output:
        f"{LATEX}/main.pdf",
    conda:
        "envs/tex.yml"
    shell:
        f"cd {LATEX} && tectonic main.tex"


# latexdiff of the current manuscript against the ensemble-sampling baseline in
# LATEX_BASE, following the sister project's manuscript_submitted / _diff
# layout. The script flattens the sections/ includes into one file, leaves
# figures unmarked (a moved figure otherwise renders as a full-page
# strikethrough), and holds the inline bibliography out of the markup.
rule manuscript_diff_tex:
    input:
        old=f"{LATEX_BASE}/main.tex",
        old_sections=glob.glob(f"{LATEX_BASE}/sections/*.tex"),
        new=f"{LATEX}/main.tex",
        new_sections=glob.glob(f"{LATEX}/sections/*.tex"),
    output:
        f"{LATEX_DIFF}/main.tex",
    conda:
        "envs/latexdiff.yml"
    script:
        "scripts/make_manuscript_diff.py"


# Compile the marked-up document. The diff .tex is flattened but still points
# at figures/, tables/, the bibliography and the style by relative path, so the
# current ones are linked in beside it rather than copied.
rule manuscript_diff:
    input:
        tex=f"{LATEX_DIFF}/main.tex",
        pdf=f"{LATEX}/main.pdf",
    output:
        f"{LATEX_DIFF}/main.pdf",
    conda:
        "envs/tex.yml"
    shell:
        "cd " + LATEX_DIFF + " && "
        "for d in figures tables sections; do "
        "  [ -e $d ] || ln -s ../latex/$d $d; done && "
        "for f in refs.bib genetics.bst; do "
        "  [ -e $f ] || ln -s ../latex/$f $f; done && "
        "tectonic main.tex"


# Re-execute the docs Jupyter notebooks in place, refreshing their committed
# outputs. The docs build itself does NOT re-execute them (conf.py sets
# ``nb_execution_mode = "off"``), so run this on demand after code changes that
# affect notebook output. The docs_notebooks target runs it and writes the
# displayed outputs to docs/outputs. Then rebuild the docs and commit:
#   snakemake -j1 --scheduler greedy docs_notebooks
DOCS_NOTEBOOKS = sorted(glob.glob("docs/reference/Python/*.ipynb"))


rule cli_transcripts:
    """Regenerate the CLI example output embedded in the docs."""
    input:
        "docs/run_cli_examples.py",
        "docs/_static/demo.vcf.gz",
        "docs/_static/demo.trees",
        "docs/_static/demo_species_tree.nwk",
    output:
        # usage.rst embeds the .html via `.. raw:: html`, so they are outputs:
        # undeclared, a failed run leaves tracebacks on three published pages.
        expand("docs/reference/CLI/_output/{name}.{ext}",
               name=["fixed_tree", "arg", "local_tree"], ext=["html"]),
    conda:
        "../docs/environment.yml"
    shell:
        # ancestree reaches the env through PYTHONPATH, as for the notebooks.
        "PYTHONPATH=$PWD python docs/run_cli_examples.py"


rule execute_docs_notebooks:
    """Execute every docs notebook in place (``jupyter execute --inplace``).

    Cells tagged ``remove-cell`` assert the claims the surrounding prose
    makes, so a result that drifts fails this rule instead of publishing.
    """
    input:
        DOCS_NOTEBOOKS,
    output:
        touch(f"{REPORTS}/.docs_notebooks_executed"),
    conda:
        "../docs/environment.yml"
    shell:
        # Coalesce afterwards: jupyter stores each tqdm carriage-return update
        # as its own stderr stream, so a progress bar would otherwise render
        # split across several output blocks.
        # ancestree reaches the env through PYTHONPATH rather than a pip
        # "-e ." in the yml: conda resolves that path against its own staging
        # directory, where there is no project to install.
        "PYTHONPATH=$PWD jupyter execute --inplace --timeout=900 {input} && "
        "PYTHONPATH=$PWD python docs/coalesce_streams.py {input}"


rule extract_docs_outputs:
    """Write the outputs one executed docs notebook displays to
    ``docs/outputs/{page}``, so that result changes show up in version control.
    """
    input:
        notebook="docs/reference/Python/{page}.ipynb",
        executed=f"{REPORTS}/.docs_notebooks_executed",
    output:
        touch(f"{RESULTS}/docs/{{page}}.outputs.written"),
    conda:
        "../docs/environment.yml"
    script:
        "../docs/extract_outputs.py"


rule docs_notebooks:
    """Execute the docs notebooks and write their displayed outputs."""
    input:
        expand(f"{RESULTS}/docs/{{page}}.outputs.written",
               page=[Path(p).stem for p in DOCS_NOTEBOOKS]),


rule all:
    """Build every benchmark report."""
    default_target: True
    input:
        f"{REPORTS}/polarbear_agreement.md",
        f"{REPORTS}/estsfs_agreement.md",
        f"{REPORTS}/polytomy.md",
        f"{REPORTS}/baseline.md",


