# ------------------------------------------------------- focal interpolation
# Where the ancestral state is read: vary the reporting point from the ingroup
# MRCA to the panel root, grading each position against the truth at that same
# position. Standalone target, built with::
#
#     snakemake -j 1 --use-conda plot_focal_interpolation
FOCAL_FRACTIONS = [round(k / 40, 3) for k in range(41)]
FOCAL_N_OUTS = [1, 3, 10]
FOCAL_MODES = ["fixed_tree", "arg", "local_tree"]


rule report_focal_interpolation_shard:
    """One (mode, outgroup count) panel. The fraction grid runs inside it."""
    input:
        trees = f"{DATA}/baseline10_chunk0.trees",
    output:
        json = f"{REPORTS}/focal_interpolation_{{mode}}_n{{n_out}}.json",
    params:
        fractions = FOCAL_FRACTIONS,
        n_outs = lambda w: [int(w.n_out)],
        modes = lambda w: [w.mode],
        mu = 1.25e-8,
    wildcard_constraints:
        mode = r"[a-z_]+",
        n_out = r"[0-9]+",
    resources:
        mem_mb = 16000,
        runtime = 240,
    conda:
        "envs/bench.yml"
    script:
        "scripts/report_focal_interpolation.py"


# Pairwise TMRCA three ways, across demographies. Its own simulations rather
# than the robustness ones: those carry unequal per-chunk lengths and are the
# input to the focal-interpolation and orientation-damage benchmarks, so
# resizing them to give the rows equal sequence would strand both.
TMRCA_N_CHUNKS = 10
TMRCA_LENGTH = 5e7          # 50 Mb over the chunks, so 5 Mb each
TMRCA_SCENARIOS = {
    "baseline": OUTGROUP_EFFECT10_CONFIG,
    "pop_growth": POP_GROWTH_CONFIG,
    "pop_decline": POP_DECLINE_CONFIG,
}
TMRCA_CHUNKS = list(range(TMRCA_N_CHUNKS))


rule simulate_tmrca_scenario:
    """One chunk of one demography for the TMRCA-distribution figure."""
    output:
        trees = f"{DATA}/tmrca_sim_{{scenario}}_chunk{{chunk_idx}}.trees",
        meta = f"{DATA}/tmrca_sim_{{scenario}}_chunk{{chunk_idx}}_meta.json",
    params:
        cfg = lambda wc: dict(TMRCA_SCENARIOS[wc.scenario], length=TMRCA_LENGTH),
        n_ingroup = lambda wc: TMRCA_SCENARIOS[wc.scenario]["n_ingroup"],
        n_outgroup_pops = lambda wc: TMRCA_SCENARIOS[wc.scenario]["n_outgroup_pops"],
        length = TMRCA_LENGTH,
        mu = lambda wc: TMRCA_SCENARIOS[wc.scenario]["mu"],
        rec_rate = lambda wc: TMRCA_SCENARIOS[wc.scenario]["rec_rate"],
        pop_size = lambda wc: TMRCA_SCENARIOS[wc.scenario]["pop_size"],
        ingroup_pop_size = lambda wc: TMRCA_SCENARIOS[wc.scenario]["ingroup_pop_size"],
        ingroup_growth_rate = lambda wc: TMRCA_SCENARIOS[wc.scenario].get(
            "ingroup_growth_rate", 0.0),
        ingroup_growth_flat_time = lambda wc: TMRCA_SCENARIOS[wc.scenario].get(
            "ingroup_growth_flat_time", 0.0),
        outgroup_split_times = lambda wc: TMRCA_SCENARIOS[wc.scenario][
            "outgroup_split_times"],
        seed = lambda wc: TMRCA_SCENARIOS[wc.scenario]["seed"],
        chunk_idx = lambda wc: int(wc.chunk_idx),
        n_chunks = TMRCA_N_CHUNKS,
    wildcard_constraints:
        scenario = r"|".join(TMRCA_SCENARIOS),
        chunk_idx = r"[0-9]+",
    resources:
        mem_mb = 16000,
        runtime = 240,
    conda:
        "envs/bench.yml"
    script:
        "scripts/simulate_baseline.py"


rule report_tmrca_distributions_shard:
    """One chunk's pairwise TMRCA three ways: the simulated truth, the pairwise
    HMM's posterior mean (what the plug-in local tree is built from) and the
    FFBS draws (what ensemble mode marginalises over). Ingroup panel only, so
    the distribution is the ingroup coalescent rather than a mixture with the
    outgroup split depths. Only histograms are retained, on axes fixed in the
    script, so the shards pool by summation."""
    input:
        trees = (f"{DATA}/tmrca_sim_{{scenario}}_chunk{{chunk_idx}}.trees"),
    output:
        npz = (f"{DATA}/tmrca_distributions_{{scenario}}"
               "_chunk{chunk_idx}.npz"),
    params:
        mu = 1.25e-8,
        rec_rate = 1e-8,
        window = "8snp",
        segment = "2mb",
        n_members = 128,
        member_chunk = 8,
        seed = 1000,
        # Calibration per segment as usual, with the floor put a decade
        # deeper: the prior folds its whole lower tail into the lowest bin,
        # and at the calibrated floor that pile-up is 4x the truth there.
        floor_scale = 1.0,
    wildcard_constraints:
        scenario = r"|".join(TMRCA_SCENARIOS),
        chunk_idx = r"[0-9]+",
    resources:
        mem_mb = 16000,
        runtime = 240,
    conda:
        "envs/tmrca.yml"
    script:
        "scripts/report_tmrca_distributions.py"


rule report_tmrca_distributions:
    input:
        shards = lambda wc: expand(
            f"{DATA}/tmrca_distributions_{wc.scenario}_chunk{{c}}.npz",
            c=TMRCA_CHUNKS),
    output:
        npz = f"{DATA}/tmrca_distributions_{{scenario}}.npz",
        meta = f"{REPORTS}/tmrca_distributions_{{scenario}}_meta.json",
    wildcard_constraints:
        scenario = r"|".join(TMRCA_SCENARIOS),
    conda:
        "envs/tmrca.yml"
    script:
        "scripts/aggregate_tmrca_distributions.py"


