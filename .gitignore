# Snakemake working dir
.snakemake/

# Build artifacts: scratch dir (LaTeX intermediates live in the reports clone)
out/

# external/ holds vendored upstream baselines (est-sfs, PolarBEAR), fetched
# separately and not tracked here. Anchored: an unanchored pattern would also
# match a nested external/ at any depth.
/external/

# The manuscript lives in the separate Ancestree-manuscript repo, cloned into
# reports/ locally, and the figure/table pipeline writes into it. Anchored:
# unanchored, this also matches results/reports/, which is tracked.
/reports/

# Claude Code working dir
.claude/

# Notebook outputs written into the docs tree and removed by a hidden cell,
# present only if a run was interrupted.
docs/reference/Python/annotated.*
docs/reference/Python/snps.annotated.*
docs/reference/Python/quickstart.vcf

# Pipeline intermediates under results/data/, regenerated by the Snakemake
# rules. The pattern excludes the contents rather than the directory: git
# cannot re-include a file whose parent directory is excluded, and the
# negation below keeps the light per-cell robustness summaries (a few KB
# each), the sufficient statistics from which every robustness figure
# regenerates without recomputation.
results/data/*
!results/data/robustness_cell_*_summary.json

# Per-outgroup shards of the focal-interpolation ensemble. Every row they
# hold is in the merged focal_interpolation_local_tree_ens.json.
results/reports/focal_ens_shard_n*.json

# Snakemake touch() sentinel: tracking it would tell a clone the docs
# notebooks are already executed.
results/reports/.docs_notebooks_executed

# Reference PDFs, not distributed
/Literature/
